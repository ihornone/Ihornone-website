# Static assets (hashed files from build, fonts, CSS) - cache forever in browser and Cloudflare CDN
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Public static images - cache for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Public SVG icons
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML pages - instant CDN edge delivery with background revalidation
/*
  Cache-Control: public, max-age=0, must-revalidate

# Embeddable script for demo projects
/moki-badge.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/badge.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Security headers (mirror astro dev server.headers; SAMEORIGIN allows the /badge/ iframe)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://a.plerdy.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com https://a.plerdy.com wss://a.plerdy.com; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
