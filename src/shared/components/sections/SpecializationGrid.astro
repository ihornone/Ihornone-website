---
import Drawer from '../ui/Drawer.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
 class?: string;
}

const {
 class: className = '',
} = Astro.props;

const allItems = (await getCollection('specializations')).sort((a, b) => a.data.order - b.data.order);

// Group into 2 items per column for 100% reliable 2-row mobile horizontal scroll & desktop grid
const itemPairs: (typeof allItems)[] = [];
for (let i = 0; i < allItems.length; i += 2) {
 itemPairs.push(allItems.slice(i, i + 2));
}

// Rotating brand palette for the icon tiles
const tileColors = ['bg-[#D09AFC]', 'bg-[#E8BA98]', 'bg-[#FAC3C8]', 'bg-[#F4E8E3]'];
---

<div class={`w-full relative ${className}`}>
 <!-- 2-Row Horizontal Scroll Container with Clean Padding -->
 <div
 id="spec-scroll-container"
 class="flex lg:grid lg:grid-cols-4 gap-6 sm:gap-8 overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none pt-1 pb-4 lg:pt-0 lg:pb-0 scrollbar-none touch-pan-x"
 style="-webkit-overflow-scrolling: touch; overscroll-behavior-x: contain;"
 data-animate="fade-up"
 data-stagger
 >
 {itemPairs.map((pair, pairIndex) => (
 <div class="flex flex-col gap-6 sm:gap-8 w-[78vw] sm:w-[310px] lg:w-auto shrink-0 snap-start">
 {pair.map((item, itemIndex) => (
 <button
 type="button"
 class="spec-item bg-white border-2 border-[#1E1414] rounded-2xl p-6 flex items-center gap-4 text-left transition-[translate,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_8px_0_#D09AFC] cursor-pointer w-full flex-1 group motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
 data-drawer-open="spec-drawer"
 data-drawer-panel={item.id}
 data-drawer-title={item.data.title}
 data-drawer-icon={item.data.icon}
 >
 <div class:list={[
 "w-12 h-12 rounded-xl border-2 border-[#1E1414] flex items-center justify-center shrink-0 text-[#1E1414] transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105",
 tileColors[(pairIndex * 2 + itemIndex) % tileColors.length],
 ]}>
 <Icon name={item.data.icon} size={22} class="text-[#1E1414]" />
 </div>
 <div class="min-w-0 flex-1">
 <strong class="text-sm sm:text-base font-black text-[#1E1414] block leading-snug group-hover:text-[#95553C] transition-colors">{item.data.title}</strong>
 <span class="text-xs text-[#623A2D]/70 block leading-tight mt-1 truncate font-medium">{item.data.desc}</span>
 </div>
 </button>
 ))}
 </div>
 ))}
 </div>
</div>

<!--
 Розгорнутий опис кожної спеціалізації рендериться на сервері, а не підставляється
 з data-атрибутів: текст потрапляє в HTML (краулери бачать опис), а не лише в пам'ять
 браузера після кліку.
-->
<Drawer id="spec-drawer" title="Спеціалізація">
 {allItems.map((item) => (
 <div data-drawer-panel-value={item.id}>
 <p class=" text-sm sm:text-base leading-relaxed font-medium text-[#623A2D]/85">
 {item.data.fullDescription || item.data.desc}
 </p>
 </div>
 ))}
</Drawer>

<script>
 document.addEventListener('astro:page-load', () => {
 const container = document.getElementById('spec-scroll-container');
 if (!container || container.dataset.dragBound === 'true') return;
 container.dataset.dragBound = 'true';

 const items = container.querySelectorAll('.spec-item');

 // Drag-to-scroll support for mouse/trackpad swipe simulation
 let isDown = false;
 let startX = 0;
 let scrollLeft = 0;
 let isDragging = false;

 container.addEventListener('mousedown', (e) => {
 isDown = true;
 isDragging = false;
 startX = e.pageX - container.offsetLeft;
 scrollLeft = container.scrollLeft;
 });

 window.addEventListener('mouseup', () => {
 isDown = false;
 });

 container.addEventListener('mousemove', (e) => {
 if (!isDown) return;
 const x = e.pageX - container.offsetLeft;
 const walk = x - startX;
 if (Math.abs(walk) > 5) {
 isDragging = true;
 }
 container.scrollLeft = scrollLeft - walk;
 });

 // Prevent click triggering drawer when dragging
 items.forEach((item) => {
 item.addEventListener(
 'click',
 (e) => {
 if (isDragging) {
 e.stopImmediatePropagation();
 e.preventDefault();
 isDragging = false;
 }
 },
 true
 );
 });
 });
</script>
