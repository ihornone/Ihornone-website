---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class:list={[
    "relative w-full h-[100dvh] min-h-[640px] overflow-hidden",
    className,
  ]}
>
  <!-- Fullscreen Edge-to-Edge Background Image -->
  <div class="absolute inset-0 w-full h-full z-0">
    <img
      src="/images/mascot/hero-cat.webp"
      alt="Dev-кіт ihornone у чорному худі за макбуком"
      class="w-full h-full object-cover object-center sm:object-[center_35%] scale-100 hero-ambient-zoom"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Subtle overall cinematic vignette -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#2A1E1E]/40 via-transparent to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#2A1E1E]/80 via-transparent to-transparent pointer-events-none"
    >
    </div>
  </div>

  <!-- Center-Left Text Block with seamless feathered blur glow behind text -->
  <div
    class="absolute top-1/2 -translate-y-1/2 left-6 sm:left-10 lg:left-14 z-10 max-w-xl lg:max-w-2xl text-left pointer-events-auto animate-hero-fade-in"
  >
    <!-- Seamless soft blur & dark glow behind text (no rectangle borders) -->
    <div class="absolute -inset-6 sm:-inset-10 backdrop-blur-md bg-[#2A1E1E]/50 [mask-image:radial-gradient(ellipse_at_center,black_45%,transparent_80%)] pointer-events-none -z-10"></div>

    <h1
      class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] m-0 drop-shadow-md"
    >
      Сайти, боти та сервіси, які <span class="text-[#D09AFC]">приносять заявки</span> й автоматизують бізнес
    </h1>
  </div>

  <!-- Bottom-Right Carved Buttons Pocket (Seamless Organic Curves matching site design system) -->
  <div class="absolute bottom-0 right-0 z-20 pointer-events-auto">
    <div
      class="relative bg-[#FAF1EC] rounded-tl-[24px] sm:rounded-tl-[28px] px-5 sm:px-6 py-3.5 sm:py-4 shadow-md flex items-center gap-3 sm:gap-3.5"
    >
      <!-- Inverted Scoop Curve (Above the plate along the right edge: curves smoothly inwards R=24) -->
      <svg
        class="absolute -top-[24px] right-0 w-[24px] h-[24px] pointer-events-none"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M24 24 V0 A 24 24 0 0 1 0 24 H24 Z" fill="#FAF1EC"></path>
      </svg>

      <!-- Inverted Scoop Curve (To the left of the plate along the bottom edge: curves smoothly inwards R=24) -->
      <svg
        class="absolute bottom-0 -left-[24px] w-[24px] h-[24px] pointer-events-none"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M24 24 H0 A 24 24 0 0 0 24 0 V24 Z" fill="#FAF1EC"></path>
      </svg>

      <!-- Lavender Primary Button with Pulse Glow (Capsule rounded-full) -->
      <a
        href="https://t.me/ihornone"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full font-black text-xs sm:text-sm px-6 sm:px-7 py-3 bg-[#D09AFC] text-[#2A1E1E] animate-pulse-glow hover:bg-[#BF80FA] hover:-translate-y-0.5 active:translate-y-0 transition-all no-underline group shadow-xs"
      >
        <i
          class="fa-brands fa-telegram text-[#2A1E1E] text-base group-hover:scale-110 transition-transform"
        ></i>
        <span>Обговорити в Telegram</span>
        <i class="fa-solid fa-arrow-right text-[10px] text-[#2A1E1E]"></i>
      </a>

      <!-- Dark Contrast Button (Capsule rounded-full) -->
      <a
        href="/portfolio"
        class="inline-flex items-center justify-center gap-2 rounded-full font-bold text-xs sm:text-sm px-6 sm:px-7 py-3 bg-[#2A1E1E] hover:bg-[#3D2C2C] text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all no-underline"
      >
        <span>Дивитися кейси</span>
        <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-75"
        ></i>
      </a>
    </div>
  </div>

  <!-- Subtle Scroll Down Indicator in Glass Pill -->
  <a
    href="#services"
    class="absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 z-10 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/25 hover:bg-black/45 backdrop-blur-md border border-white/20 text-[#FAF1EC] hover:text-white transition-all no-underline text-xs font-bold shadow-xs"
    aria-label="Гортати вниз"
  >
    <span>Гортати вниз</span>
    <i class="fa-solid fa-chevron-down text-[10px] animate-bounce"></i>
  </a>
</section>
