---
import Icon from '../ui/Icon.astro';
import MokiMorpher from '../moki/MokiMorpher';

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class:list={[
    "hero-interactive-container relative w-full min-h-[76dvh] lg:min-h-[82dvh] h-auto flex items-center justify-center overflow-hidden rounded-b-[40px] sm:rounded-b-[64px] bg-[#FAF1EC] border-b-2 border-[#1E1414]/10 py-14 sm:py-18 lg:py-20 select-none",
    className,
  ]}
>
  <div class="absolute inset-0 w-full h-full pointer-events-none overflow-hidden z-0">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-75"
      style="background-image: url('/images/hero-bg.jpg');"
    ></div>
    <div class="absolute inset-0 bg-[radial-gradient(#1E1414_1px,transparent_1px)] [background-size:28px_28px] opacity-[0.035]"></div>
  </div>

  <!-- Central Hero Content -->
  <div class="hero-text-block relative z-20 max-w-2xl sm:max-w-3xl lg:max-w-4xl xl:max-w-5xl text-center px-4 sm:px-6 flex flex-col items-center pointer-events-auto">
    <!-- Main Headline -->
    <h1 class="hero-title flex flex-col items-center justify-center text-center m-0 select-none">
      <!-- Рядок 1 (жирний): «Сайти, боти» + Moki (ліловий, великий, без рамки, впритул) + «та сервіси» -->
      <span
        class="inline-flex items-center justify-center flex-wrap sm:flex-nowrap gap-x-1 sm:gap-x-1.5 gap-y-2 text-3xl sm:text-5xl md:text-6xl lg:text-[68px] xl:text-[76px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.16]"
      >
        <span data-reveal-text class="whitespace-nowrap">Сайти, боти</span>
        <span
          class="moki-interactive-node inline-flex items-center justify-center w-[1.45em] h-[1.45em] sm:w-[1.6em] sm:h-[1.6em] align-middle -mt-[0.06em] -mx-0.5 sm:-mx-1 transition-transform duration-200 hover:scale-110 active:scale-95 cursor-pointer shrink-0 select-none group/moki"
          title="Привіт від Мокі! Клікни, щоб змінити форму ✨"
          aria-label="Інтерактивний Мокі"
        >
          <MokiMorpher
            client:load
            size={180}
            color="#D09AFC"
            expression="heureux"
            follow="page"
            interval={3200}
            className="w-full h-full [&>svg]:w-full [&>svg]:h-full [&>svg]:overflow-visible"
          />
        </span>
        <span data-reveal-text class="whitespace-nowrap">та сервіси</span>
      </span>

      <!-- Рядок 2 (light): «які приносять заявки» -->
      <span
        data-reveal-text
        class="block text-2xl sm:text-4xl md:text-5xl lg:text-[56px] xl:text-[64px] font-light text-[#1E1414] tracking-[-0.025em] leading-[1.18] mt-2 sm:mt-3"
      >
        які приносять заявки
      </span>
    </h1>

    <!-- Три чіпи з пастельними іконками: «Заявки», «Оплати», «Гарантія 30 днів» -->
    <div
      class="hero-chips flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5 pt-6 sm:pt-8"
      role="list"
      aria-label="Ключові напрямки та гарантії"
    >
      <!-- Чіп 1: Заявки -->
      <div
        role="listitem"
        class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-white border-2 border-[#1E1414] shadow-[2.5px_2.5px_0_#1E1414] hover:shadow-[4px_4px_0_#D09AFC] hover:-translate-y-0.5 transition-[box-shadow,translate] motion-reduce:transition-none motion-reduce:hover:shadow-[2.5px_2.5px_0_#1E1414] motion-reduce:hover:translate-y-0 select-none group/chip cursor-default"
      >
        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-[#D09AFC]/35 border border-[#1E1414]/15 flex items-center justify-center text-[#1E1414] shrink-0 group-hover/chip:scale-110 transition-transform motion-reduce:transition-none motion-reduce:group-hover/chip:scale-100">
          <Icon name="sparkles" size={14} class="sm:scale-110 text-[#6B21A8]" />
        </span>
        <span class="text-xs sm:text-sm font-black text-[#1E1414] tracking-tight">Заявки</span>
      </div>

      <!-- Чіп 2: Оплати -->
      <div
        role="listitem"
        class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-white border-2 border-[#1E1414] shadow-[2.5px_2.5px_0_#1E1414] hover:shadow-[4px_4px_0_#E8BA98] hover:-translate-y-0.5 transition-[box-shadow,translate] motion-reduce:transition-none motion-reduce:hover:shadow-[2.5px_2.5px_0_#1E1414] motion-reduce:hover:translate-y-0 select-none group/chip cursor-default"
      >
        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-[#E8BA98]/45 border border-[#1E1414]/15 flex items-center justify-center text-[#1E1414] shrink-0 group-hover/chip:scale-110 transition-transform motion-reduce:transition-none motion-reduce:group-hover/chip:scale-100">
          <Icon name="credit-card" size={14} class="sm:scale-110 text-[#95553C]" />
        </span>
        <span class="text-xs sm:text-sm font-black text-[#1E1414] tracking-tight">Оплати</span>
      </div>

      <!-- Чіп 3: Гарантія 30 днів -->
      <div
        role="listitem"
        class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-white border-2 border-[#1E1414] shadow-[2.5px_2.5px_0_#1E1414] hover:shadow-[4px_4px_0_#FAC3C8] hover:-translate-y-0.5 transition-[box-shadow,translate] motion-reduce:transition-none motion-reduce:hover:shadow-[2.5px_2.5px_0_#1E1414] motion-reduce:hover:translate-y-0 select-none group/chip cursor-default"
      >
        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-[#FAC3C8]/50 border border-[#1E1414]/15 flex items-center justify-center text-[#1E1414] shrink-0 group-hover/chip:scale-110 transition-transform motion-reduce:transition-none motion-reduce:group-hover/chip:scale-100">
          <Icon name="shield-check" size={14} class="sm:scale-110 text-[#BE185D]" />
        </span>
        <span class="text-xs sm:text-sm font-black text-[#1E1414] tracking-tight">Гарантія 30 днів</span>
      </div>
    </div>

    <!-- Одна головна кнопка «Обговорити в Telegram» під чіпами -->
    <div class="hero-cta-group flex items-center justify-center pt-6 sm:pt-8 w-full sm:w-auto px-4 sm:px-0">
      <a
        href="https://t.me/ihornone"
        target="_blank"
        rel="noopener noreferrer"
        class="pill-btn-primary hero-btn-primary group w-full sm:w-auto !px-8 !py-3.5 sm:!py-4 text-sm sm:text-base"
        data-magnetic="10"
      >
        <Icon
          name="telegram"
          size={18}
          class="group-hover:scale-110 transition-transform motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
        <span>Обговорити в Telegram</span>
        <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" />
      </a>
    </div>
  </div>
</section>

<script>
  function initMokiRejoice() {
    const nodes = document.querySelectorAll('.moki-interactive-node');
    const symbols = ['✦', '✨', '💜', '⚡', '🎉'];
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        // Rare celebratory burst — skipped entirely under reduced motion.
        if (REDUCED) return;
        const rect = node.getBoundingClientRect();
        for (let i = 0; i < 5; i++) {
          const particle = document.createElement('span');
          particle.textContent = symbols[Math.floor(Math.random() * symbols.length)];
          particle.style.position = 'fixed';
          particle.style.pointerEvents = 'none';
          particle.style.fontSize = `${14 + Math.random() * 8}px`;
          particle.style.fontWeight = 'bold';
          particle.style.userSelect = 'none';
          particle.style.zIndex = '9999';
          particle.style.color = i % 2 === 0 ? '#9333EA' : '#DB2777';
          const startX = rect.left + rect.width / 2 + (Math.random() - 0.5) * 30;
          const startY = rect.top + rect.height / 2 + (Math.random() - 0.5) * 20;
          particle.style.left = `${startX}px`;
          particle.style.top = `${startY}px`;
          particle.style.opacity = '1';
          particle.style.transform = 'translate(-50%, -50%) scale(0.6)';
          particle.style.transition = 'transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1)';
          document.body.appendChild(particle);

          requestAnimationFrame(() => {
            const offsetX = (Math.random() - 0.5) * 70;
            const offsetY = -45 - Math.random() * 45;
            particle.style.transform = `translate(calc(-50% + ${offsetX}px), calc(-50% + ${offsetY}px)) scale(1.2)`;
            particle.style.opacity = '0';
          });

          setTimeout(() => particle.remove(), 900);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initMokiRejoice);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMokiRejoice);
  } else {
    initMokiRejoice();
  }
</script>
