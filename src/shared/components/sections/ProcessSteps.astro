---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface ProcessStep {
  step: number;
  title: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  steps?: ProcessStep[];
  class?: string;
}

const {
  title = 'Як відбувається процес розробки',
  subtitle = 'Прозорий та структурований шлях від першого обговорення до релізу',
  steps = [],
  class: className = '',
} = Astro.props;

// Keep exactly 4 steps
const displaySteps = steps.slice(0, 4);
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <SectionHeader
    title={title}
    highlight="процес"
    tagColor="caramel"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 xl:gap-8 items-stretch" data-animate="fade-up" data-stagger>
    {displaySteps.map((step) => (
      <Card hover class="space-y-4 relative overflow-hidden h-full flex flex-col justify-start p-6 lg:p-5 xl:p-6">
        <span class="text-3xl sm:text-4xl font-black text-[#D09AFC] tracking-tight block">
          {String(step.step).padStart(2, '0')}
        </span>
        <div class="space-y-2 flex-1">
          <h3 class="text-lg sm:text-[19px] font-black text-[#1E1414] tracking-tight leading-snug">
            {step.title}
          </h3>
          <p class="text-xs sm:text-[13.5px] text-[#1E1414]/85 font-medium leading-relaxed">
            {step.description}
          </p>
        </div>
      </Card>
    ))}
  </div>
</section>
