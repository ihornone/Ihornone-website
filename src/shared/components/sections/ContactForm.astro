---
import Tag from '../ui/Tag.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import IconBox from '../ui/IconBox.astro';
import Icon from '../ui/Icon.astro';
import { getCollection } from 'astro:content';

interface Benefit {
 icon: string;
 title: string;
 description: string;
}

interface Props {
 benefits?: Benefit[];
 class?: string;
}

const defaultBenefits: Benefit[] = [
 {
 icon: 'clock',
 title: 'Швидка відповідь',
 description: 'Відповім протягом 24 годин',
 },
 {
 icon: 'message-square',
 title: 'Безкоштовна консультація',
 description: 'Обговоримо ідею безкоштовно',
 },
 {
 icon: 'file-text',
 title: 'Прозорі умови',
 description: 'Чітка угода та терміни',
 },
];

const {
 benefits = defaultBenefits,
 class: className = '',
} = Astro.props;

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section class:list={['grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 items-start w-full', className]} aria-labelledby="contact-form-heading">
 <div class="space-y-6">
 <div>
 <h2
 id="contact-form-heading"
 data-reveal-text
 class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13]"
 >
 Напишіть <Tag color="lilac" class="mx-1">мені</Tag>
 </h2>
 </div>

 <div class="space-y-4" role="list" aria-label="Переваги співпраці">
 {benefits.map((benefit) => (
 <div class="bg-white border-2 border-[#1E1414] rounded-2xl p-4 sm:p-6 flex items-center gap-4 transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none" role="listitem">
 <div class="w-10 h-10 rounded-full bg-[#E8BA98] border-2 border-[#1E1414] flex items-center justify-center text-[#1E1414] shrink-0">
 <Icon name={benefit.icon} size={18} />
 </div>
 <div>
 <h4 class="text-sm font-black text-[#1E1414] ">{benefit.title}</h4>
 <p class="text-xs text-[#623A2D]/75 font-medium mt-1">{benefit.description}</p>
 </div>
 </div>
 ))}
 </div>
 </div>

 <div class="bento-card p-6 sm:p-8 w-full">
 <form class="space-y-4" id="contact-form" aria-describedby="form-instructions">
 <p id="form-instructions" class="sr-only">Заповніть форму для зв'язку. Поля з позначкою * обов'язкові.</p>
 
 <div class="space-y-2">
 <label class="text-xs font-black text-[#2A1E1E] uppercase tracking-wider block" for="name">
 Ім'я <span class="text-red-500" aria-hidden="true">*</span>
 </label>
 <input
 class="w-full bg-[#FAF1EC]/30 border-2 border-[#1E1414]/25 rounded-xl px-4 py-3 text-sm text-[#1E1414] outline-none focus:bg-white focus:border-[#D09AFC] transition-[background-color,border-color]"
 type="text"
 id="name"
 name="name"
 placeholder="Ваше ім'я"
 required
 aria-required="true"
 autocomplete="name"
 />
 </div>

 <div class="space-y-2">
 <label class="text-xs font-black text-[#2A1E1E] uppercase tracking-wider block" for="contact">
 Зручний зв'язок <span class="text-red-500" aria-hidden="true">*</span>
 </label>
 <input
 class="w-full bg-[#FAF1EC]/30 border-2 border-[#1E1414]/25 rounded-xl px-4 py-3 text-sm text-[#1E1414] outline-none focus:bg-white focus:border-[#D09AFC] transition-[background-color,border-color]"
 type="text"
 id="contact"
 name="contact"
 placeholder="Telegram, email або телефон"
 required
 aria-required="true"
 autocomplete="email tel"
 />
 </div>

 <div class="space-y-2">
 <label id="service-label" class="text-xs font-black text-[#2A1E1E] uppercase tracking-wider block">
 Послуга <span class="text-red-500" aria-hidden="true">*</span>
 </label>
 <input type="hidden" id="service" name="service" required aria-required="true" />
 <div class="relative" id="service-dropdown">
 <button
 type="button"
 class="w-full bg-[#FAF1EC]/30 border-2 border-[#1E1414]/25 rounded-xl px-4 py-3 text-sm text-left outline-none focus:bg-white focus:border-[#D09AFC] transition-[background-color,border-color] cursor-pointer flex items-center justify-between gap-2 text-[#1E1414]"
 id="service-trigger"
 aria-haspopup="listbox"
 aria-expanded="false"
 aria-labelledby="service-label"
 >
 <span class="flex items-center gap-3" id="service-trigger-content">
 <span class="text-[#623A2D]/50 font-medium">Оберіть послугу</span>
 </span>
 <Icon name="chevron-down" id="service-arrow" size={14} class="text-[#623A2D]/50 transition-transform duration-200" />
 </button>
 <div
 class="absolute top-full left-0 right-0 mt-2 bg-white border-2 border-[#1E1414] rounded-2xl shadow-lg overflow-hidden z-50 hidden"
 id="service-options"
 role="listbox"
 aria-labelledby="service-label"
 >
 <div class="p-2 space-y-1">
 {allServices.map((service) => (
 <button
 type="button"
 class="service-option w-full flex items-center gap-3 px-4 py-3 rounded-full text-sm text-left hover:bg-[#FAF1EC] transition-colors cursor-pointer"
 data-value={service.id}
 data-icon={service.data.icon}
 data-title={service.data.title}
 role="option"
 aria-selected="false"
 >
 <div class="w-8 h-8 rounded-full bg-[#FAF1EC] border border-[#623A2D]/10 flex items-center justify-center shrink-0">
 <Icon name={service.data.icon} size={16} class="text-[#2A1E1E]" />
 </div>
 <span class="font-bold text-[#2A1E1E]">{service.data.title}</span>
 </button>
 ))}
 <button
 type="button"
 class="service-option w-full flex items-center gap-3 px-4 py-3 rounded-full text-sm text-left hover:bg-[#FAF1EC] transition-colors cursor-pointer"
 data-value="other"
 data-icon="ellipsis"
 data-title="Інше"
 role="option"
 aria-selected="false"
 >
 <div class="w-8 h-8 rounded-full bg-[#FAF1EC] border border-[#623A2D]/10 flex items-center justify-center shrink-0">
 <Icon name="ellipsis" size={16} class="text-[#2A1E1E]/60" />
 </div>
 <span class="font-bold text-[#2A1E1E]">Інше</span>
 </button>
 </div>
 </div>
 </div>
 </div>

 <div class="space-y-2">
 <label class="text-xs font-black text-[#2A1E1E] uppercase tracking-wider block" for="message">
 Опишіть проєкт <span class="text-red-500" aria-hidden="true">*</span>
 </label>
 <textarea
 class="w-full bg-[#FAF1EC]/30 border-2 border-[#1E1414]/25 rounded-xl px-4 py-3 text-sm text-[#1E1414] outline-none focus:bg-white focus:border-[#D09AFC] transition-[background-color,border-color] min-h-[110px] resize-y"
 id="message"
 name="message"
 placeholder="Коротко опишіть вашу ідею або задачу..."
 rows="4"
 required
 aria-required="true"
 ></textarea>
 </div>

 <button
 type="submit"
 class="pill-btn-lilac w-full !py-4 !text-sm flex items-center justify-center gap-2 mt-2"
 id="submit-btn"
 >
 <span id="submit-text">Надіслати заявку</span>
 <span id="submit-icon"><Icon name="arrow-right" size={14} /></span>
 <svg class="animate-spin h-4 w-4 hidden" id="submit-spinner" viewBox="0 0 24 24" aria-hidden="true">
 <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
 <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
 </svg>
 </button>

 <div id="form-status" class="text-sm text-center font-bold" role="status" aria-live="polite"></div>
 </form>
 </div>
</section>

<script>
 document.addEventListener('astro:page-load', () => {
 const form = document.getElementById('contact-form') as HTMLFormElement | null;
 const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
 const submitText = document.getElementById('submit-text');
 const submitIcon = document.getElementById('submit-icon');
 const submitSpinner = document.getElementById('submit-spinner');
 const formStatus = document.getElementById('form-status');

 // Custom dropdown
 const dropdown = document.getElementById('service-dropdown');
 const trigger = document.getElementById('service-trigger');
 const triggerContent = document.getElementById('service-trigger-content');
 const optionsPanel = document.getElementById('service-options');
 const arrow = document.getElementById('service-arrow');
 const hiddenInput = document.getElementById('service') as HTMLInputElement | null;
 const options = document.querySelectorAll('.service-option');

 if (dropdown && trigger && triggerContent && optionsPanel && arrow && hiddenInput) {
 trigger.addEventListener('click', () => {
 const isOpen = !optionsPanel.classList.contains('hidden');
 optionsPanel.classList.toggle('hidden');
 arrow.classList.toggle('rotate-180');
 trigger.classList.toggle('border-cobalt-pop');
 trigger.setAttribute('aria-expanded', String(!isOpen));
 });

 options.forEach((option) => {
 option.addEventListener('click', () => {
 const value = option.getAttribute('data-value') || '';
 const icon = option.getAttribute('data-icon') || '';
 const title = option.getAttribute('data-title') || '';

 const optionIcon = option.querySelector('.w-8')?.innerHTML || '';

 hiddenInput.value = value;
 triggerContent.innerHTML = `
 <div class="w-8 h-8 rounded-lg bg-kofi-blue/40 flex items-center justify-center shrink-0 text-[#3b5bdb]">
 ${optionIcon}
 </div>
 <span class="font-medium text-ink-black">${title}</span>
 `;

 optionsPanel.classList.add('hidden');
 arrow.classList.remove('rotate-180');
 trigger.classList.remove('border-cobalt-pop');
 trigger.setAttribute('aria-expanded', 'false');
 hiddenInput.removeAttribute('aria-invalid');
 });
 });

 document.addEventListener('click', (e) => {
 if (!dropdown.contains(e.target as Node)) {
 optionsPanel.classList.add('hidden');
 arrow.classList.remove('rotate-180');
 trigger.classList.remove('border-cobalt-pop');
 trigger.setAttribute('aria-expanded', 'false');
 }
 });
 }

 if (!form || !submitBtn || !submitText || !submitIcon || !submitSpinner || !formStatus) return;

 const btn = submitBtn;
 const text = submitText;
 const icon = submitIcon;
 const spinner = submitSpinner;
 const status = formStatus;

 let isLoading = false;

 function setLoading(loading: boolean) {
 isLoading = loading;
 btn.disabled = loading;
 text.textContent = loading ? 'Надсилаю...' : 'Надіслати';
 icon.classList.toggle('hidden', loading);
 spinner.classList.toggle('hidden', !loading);
 }

 function showStatus(message: string, isError: boolean) {
 status.textContent = message;
 status.className = `text-sm text-center ${isError ? 'text-red-600' : 'text-green-600'}`;
 }

 form.addEventListener('submit', async (e) => {
 e.preventDefault();
 if (isLoading) return;

 setLoading(true);
 showStatus('', false);

 try {
 const formData = new FormData(form);
 const response = await fetch('/api/contact', {
 method: 'POST',
 body: formData,
 });

 const result = await response.json();

 if (!response.ok) {
 throw new Error(result.error || 'Помилка');
 }
 
 showStatus('Повідомлення надіслано! Я зв\'яжусь з вами протягом 24 годин.', false);
 form.reset();
 if (triggerContent) {
 triggerContent.innerHTML = '<span class="text-black/40">Оберіть послугу</span>';
 }
 if (hiddenInput) hiddenInput.value = '';
 } catch {
 showStatus('Помилка при надсиланні. Спробуйте ще раз або напишіть мені напряму.', true);
 } finally {
 setLoading(false);
 }
 });

 const requiredFields = form.querySelectorAll('[required]');
 requiredFields.forEach((field) => {
 field.addEventListener('blur', () => {
 const input = field as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
 if (input.value.trim() === '') {
 input.setAttribute('aria-invalid', 'true');
 } else {
 input.removeAttribute('aria-invalid');
 }
 });
 });
 });
</script>
