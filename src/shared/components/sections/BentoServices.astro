---
import { getCollection } from 'astro:content';
import ServiceCard from './ServiceCard.astro';
import Tag from '../ui/Tag.astro';
import Arrow from '../ui/Arrow.astro';

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="w-full space-y-8" data-animate="fade-up">

 <!-- Left-aligned Section Header with inline sticker highlight -->
 <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
 <h2
 data-reveal-text
 class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13] text-left"
 >
 <Tag color="lilac" class="mx-1">Послуги</Tag> індивідуальної розробки під ключ
 </h2>

 <a
 href="/services/"
 class="inline-flex items-center gap-2 text-sm font-black text-[#1E1414] hover:text-[#95553C] transition-colors group no-underline self-start sm:self-auto shrink-0 pb-1"
 >
 <span>Усі послуги</span>
 <Arrow class="transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 motion-reduce:transition-none" />
 </a>
 </div>

 <!-- Cards Grid -->
 <div
 class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch"
 data-animate="fade-up"
 data-stagger
 >
 {allServices.map((service, index) => {
 const firstPlan = service.data.pricing?.[0];
 const startingPrice = firstPlan ? `${firstPlan.price}` : '';
 return (
 <div>
 <ServiceCard
 id={service.id}
 icon={service.data.icon}
 title={service.data.title}
 shortTitle={service.data.shortTitle}
 description={service.data.description}
 isPopular={service.data.isPopular}
 startingPrice={startingPrice}
 />
 </div>
 );
 })}
 </div>

</section>
