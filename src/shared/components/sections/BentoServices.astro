---
import { getCollection } from 'astro:content';
import ServiceCard from './ServiceCard.astro';

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
  
  <!-- Left-aligned Section Header without badge or subtitle -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
      Рішення для масштабування бізнесу
    </h2>

    <a
      href="/services"
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-black text-[#2A1E1E] hover:text-[#95553C] transition-colors group no-underline self-start sm:self-auto shrink-0 pb-1"
    >
      <span>Усі послуги</span>
      <i class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1"></i>
    </a>
  </div>

  <!-- Cards Grid -->
  <div
    class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 items-stretch"
    data-animate="fade-up"
    data-stagger
  >
    {allServices.map((service) => {
      const firstPlan = service.data.pricing?.[0];
      const startingPrice = firstPlan ? `${firstPlan.price}` : '';
      return (
        <ServiceCard
          id={service.id}
          icon={service.data.icon}
          title={service.data.title}
          shortTitle={service.data.shortTitle}
          description={service.data.description}
          isPopular={service.data.isPopular}
          startingPrice={startingPrice}
        />
      );
    })}
  </div>

</section>
