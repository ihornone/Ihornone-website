---
import Button from '../ui/Button.astro';

interface Props {
  badge?: {
    text: string;
    icon?: string;
  };
  title: string;
  subtitle?: string;
  buttons?: {
    label: string;
    href: string;
    variant?: 'primary' | 'outline' | 'dark';
    icon?: string;
  }[];
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  buttons = [],
  align = 'center',
  class: className = '',
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
};

const contentAlignClasses = {
  left: 'items-start',
  center: 'items-center',
};
---

<section class={`w-full py-6 md:py-10 ${className}`}>
  <div class={`flex flex-col ${contentAlignClasses[align]} gap-5 max-w-4xl ${align === 'center' ? 'mx-auto' : ''}`}>
    
    <h1 class={`text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 ${alignClasses[align]}`}>
      {title}
    </h1>

    {buttons.length > 0 && (
      <div class={`flex flex-wrap ${align === 'center' ? 'justify-center' : ''} gap-3.5 pt-2`}>
        {buttons.map((button) => (
          <Button
            href={button.href}
            variant={button.variant || 'dark'}
            size="lg"
            icon={button.icon}
          >
            {button.label}
          </Button>
        ))}
      </div>
    )}

    <slot />
  </div>
</section>
