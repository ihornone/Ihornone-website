---
const benefits = [
  {
    title: 'Досвід та чистий код',
    desc: 'Реальний практичний досвід у веб-сервісах, Telegram WebApps та додатках. Ви отримуєте протестовані рішення без експериментів на вашому бюджеті.',
    borderClass: 'border-l-[#D09AFC]',
  },
  {
    title: 'MVP за 14–28 днів',
    desc: 'Швидкий цикл без зайвої бюрократії. Перший робочий прототип ви тестуєте вже в перший тиждень, а реліз відбувається строго за графіком.',
    borderClass: 'border-l-[#E8BA98]',
  },
  {
    title: 'Чесний бюджет від 3 700 ₴',
    desc: 'Оплата виключно за чисту інженерію. Ви не переплачуєте за оренду офісу та штат асистентів, заощаджуючи до 40% бюджету.',
    borderClass: 'border-l-[#FAC3C8]',
  },
  {
    title: 'Фокус та резервний план',
    desc: 'Веду одночасно лише 1–2 проєкти. Весь код з 1-го дня живе у вашому приватному Git, а на випадок форс-мажору є перевірене підстрахування.',
    borderClass: 'border-l-[#BF80FA]',
    hasMascot: true,
  },
];
---

<section id="advantages" class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
  
  <!-- Left-aligned Section Header without badge or subtitle -->
  <div class="w-full">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
      Чому зі мною надійніше, ніж в агентствах
    </h2>
  </div>

  <!-- Cards in a single line (4 columns starting from tablet/md screens) -->
  <div class="w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5 lg:gap-6 items-stretch">
    {benefits.map((b) => (
      <div
        class:list={[
          'relative bg-white border border-[#623A2D]/10 border-l-[6px] rounded-[22px] p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-[0_16px_36px_rgba(42,30,30,0.06)] hover:shadow-[0_24px_48px_rgba(42,30,30,0.1)] group',
          b.borderClass
        ]}
      >
        {b.hasMascot && (
          <img
            src="/images/mascot/support-cat.webp"
            alt="Маскот ihornone у худі сидить на картці підтримки"
            class="absolute -top-[58px] sm:-top-[68px] -right-2 sm:-right-3 w-20 sm:w-24 h-auto pointer-events-none z-20 drop-shadow-md group-hover:-translate-y-1.5 transition-transform duration-300"
            loading="lazy"
          />
        )}

        <div class="space-y-3">
          <!-- Title -->
          <h3 class="text-lg sm:text-[19px] font-black text-[#2A1E1E] tracking-tight m-0 leading-snug">
            {b.title}
          </h3>

          <!-- Description -->
          <p class="text-xs sm:text-[13.5px] text-[#623A2D]/80 font-medium leading-relaxed m-0">
            {b.desc}
          </p>
        </div>

      </div>
    ))}
  </div>

</section>
