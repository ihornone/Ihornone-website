---
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';

const benefits = [
 {
 title: 'Практичний досвід та архітектура',
 desc: '3+ роки розробки веб-платформ, Telegram-ботів та мобільних додатків. Ви отримуєте перевірені інженерні рішення без експериментів на вашому бюджеті.',
 icon: 'layers',
 tile: 'bg-[#D09AFC]',
 },
 {
 title: 'MVP за 14–28 днів',
 desc: 'Швидкий цикл запуску без бюрократії: перший робочий прототип ви тестуєте вже на 5–7 день, а готовий продукт виходить точно в обумовлений термін.',
 icon: 'zap',
 tile: 'bg-[#E8BA98]',
 },
 {
 title: 'Чесний бюджет від 3 700 ₴',
 desc: 'Оплата виключно за чисту інженерію. Працюючи з прямим розробником, ви економите до 40% кошторису на оренду офісів та менеджерський штат студій.',
 icon: 'coins',
 tile: 'bg-[#FAC3C8]',
 },
 {
 title: 'Фокус і безпека коду',
 desc: 'Веду одночасно не більше 1–2 проєктів. Весь код належить вам з першого коміту у вашому Git, а реліз захищено 30 днями безкоштовної гарантії.',
 icon: 'shield-check',
 tile: 'bg-[#BF80FA]',
 },
];
---

<section id="advantages" class="w-full space-y-8" data-animate="fade-up">

 <!-- Left-aligned Section Header with inline sticker highlight -->
 <div class="w-full">
 <h2
 data-reveal-text
 class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13] text-left"
 >
      Чому зі мною <Tag color="caramel" class="mx-1">вигідніше</Tag> та надійніше, ніж в агентствах
 </h2>
 </div>

  <!-- Benefit cards -->
  <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 xl:gap-8 items-stretch" data-animate="fade-up" data-stagger>
    {benefits.map((b) => (
      <div
        class:list={[
          'group relative bg-white border-2 border-[#1E1414] rounded-3xl p-6 lg:p-5 xl:p-6 flex flex-col gap-4 transition-[translate,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none',
        ]}
      >
 <div
 class:list={[
 'grid size-12 place-items-center rounded-xl border-2 border-[#1E1414] text-lg text-[#1E1414] transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:rotate-0 motion-reduce:group-hover:scale-100',
 b.tile,
 ]}
 >
 <Icon name={b.icon} size={22} />
 </div>

 <div class="space-y-2">
 <!-- Title -->
 <h3 class="text-lg sm:text-[19px] font-black text-[#1E1414] tracking-tight leading-snug">
 {b.title}
 </h3>

 <!-- Description -->
 <p class="text-xs sm:text-[13.5px] text-[#623A2D]/80 font-medium leading-relaxed ">
 {b.desc}
 </p>
 </div>

 </div>
 ))}
 </div>

</section>
