---
import { QuickContactModal } from '../ui/QuickContactModal';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = 'Маєте ідею бота, сайту чи додатку?',
  subtitle = "Напишіть мені напряму в Telegram — обговоримо концепцію, терміни та приблизний бюджет без жодних зобов'язань.",
  class: className = '',
} = Astro.props;
---

<section class:list={['w-full', className]} data-animate="fade-up">
  <!-- Container accommodating both the Cat mascot element and the full-width Card within layout width -->
  <div class="w-full flex flex-col md:flex-row items-center md:items-start relative">
    
    <!-- Mascot element: accounted for in width, upper paw grips the top edge of the card, shifted 4px right -->
    <div class="shrink-0 w-[160px] sm:w-[200px] lg:w-[240px] -mr-6 sm:-mr-8 lg:-mr-10 -mt-[96px] sm:-mt-[120px] lg:-mt-[142px] z-20 pointer-events-none select-none hidden md:block">
      <img
        src="/images/mascot/cta-cat.webp"
        alt="Маскот котик у худі з логотипом коду тримає форму"
        class="w-full h-auto drop-shadow-xl animate-cat-peek"
        loading="lazy"
      />
    </div>

    <!-- Main Card Container: stretches freely across the entire width -->
    <div class="flex-1 w-full rounded-[30px] bg-[#FAF1EC] border border-[#623A2D]/12 p-8 sm:p-14 lg:p-16 text-center relative shadow-[0_20px_50px_rgba(42,30,30,0.05)]">
      <div class="max-w-3xl mx-auto space-y-6 relative z-10">

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0">
          {title}
        </h2>

        <p class="text-sm sm:text-base lg:text-lg text-[#623A2D]/80 leading-relaxed font-medium m-0 max-w-2xl mx-auto">
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 pt-3">
          <a
            href="https://t.me/ihornone"
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn-lilac !rounded-full !text-sm sm:!text-base !px-8 !py-3.5 shadow-md animate-pulse-glow flex items-center justify-center gap-2.5 w-full sm:w-auto"
          >
            <i class="fa-brands fa-telegram text-[#2A1E1E] text-lg"></i>
            <span>Написати в Telegram</span>
            <i class="fa-solid fa-arrow-right text-xs text-[#2A1E1E]"></i>
          </a>

          <!-- Quick Contact Modal with Vaul Drawer (matching identical rounded-full pill button) -->
          <QuickContactModal
            client:load
            triggerClass="pill-btn-outline !rounded-full !text-sm sm:!text-base !px-8 !py-3.5 w-full sm:w-auto flex items-center justify-center gap-2.5 cursor-pointer shadow-2xs hover:shadow-sm"
          />
        </div>

        <div class="pt-8 border-t border-[#623A2D]/10 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs text-[#623A2D]/75 font-semibold">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-bolt text-[#D09AFC]"></i>
            Відповідь до 15 хвилин
          </span>
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-shield-check text-[#E8BA98]"></i>
            Конфіденційність ідеї
          </span>
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-handshake text-[#FAC3C8]"></i>
            Безкоштовна консультація
          </span>
        </div>

      </div>
    </div>

  </div>
</section>
