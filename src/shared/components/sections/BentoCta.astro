---
import QuickContactModal from '../ui/QuickContactModal.astro';
import Icon from '../ui/Icon.astro';
import MokiWidget from '../moki/MokiWidget.astro';

interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = 'Готові запустити проєкт або автоматизувати продажі?',
  subtitle = "Напишіть мені напряму в Telegram — обговоримо концепцію та орієнтовний кошторис без зобов'язань.",
  class: className = '',
} = Astro.props;
---

<section class:list={['w-full py-16 sm:py-20', className]} data-animate="fade-up">
  <div class="relative w-full rounded-[32px] sm:rounded-[48px] bg-white border-2 border-[#1E1414] p-8 sm:p-12 lg:p-16 text-center shadow-[0_12px_0_#D09AFC]">
    <div class="moki-float absolute -top-[52px] sm:-top-[62px] left-8 sm:left-20 lg:left-32 z-20 pointer-events-auto">
      <MokiWidget
        size={120}
        color="#D09AFC"
        shape="squircle"
        expression="heureux"
        follow="page"
      />
    </div>

    <div class="moki-float absolute -top-[48px] sm:-top-[58px] right-8 sm:right-20 lg:right-32 z-20 pointer-events-auto" style="animation-delay:-1.8s">
      <MokiWidget
        size={115}
        color="#FAC3C8"
        shape="galet"
        expression="curieux"
        follow="page"
      />
    </div>

    <div class="moki-float hidden sm:block absolute -bottom-[46px] sm:-bottom-[56px] left-16 sm:left-28 lg:left-44 z-20 pointer-events-auto" style="animation-delay:-3.6s">
      <MokiWidget
        size={105}
        color="#FAF1EC"
        shape="hexagone"
        expression="attentif"
        follow="page"
      />
    </div>

    <div class="moki-float absolute -bottom-[48px] sm:-bottom-[58px] right-10 sm:right-24 lg:right-40 z-20 pointer-events-auto" style="animation-delay:-5.2s">
      <MokiWidget
        size={115}
        color="#E8BA98"
        shape="capsule"
        expression="heureux"
        follow="page"
      />
    </div>

    <div class="max-w-4xl mx-auto space-y-5 sm:space-y-6 relative z-10 py-2 sm:py-4">
      <h2 data-reveal-text class="text-2xl sm:text-4xl lg:text-[46px] font-black text-[#1E1414] tracking-[-0.03em] leading-[1.15] max-w-3xl mx-auto text-balance m-0">
        {title}
      </h2>

      <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium max-w-xl mx-auto leading-relaxed text-balance m-0">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 pt-3">
        <a
          href="https://t.me/ihornone"
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic="8"
          class="pill-btn-lilac !text-sm sm:!text-base !px-8 !py-4 flex items-center justify-center gap-3 w-full sm:w-auto"
        >
          <Icon name="telegram" size={20} class="text-[#1E1414]" />
          <span>Написати в Telegram</span>
          <Icon name="arrow-right" size={14} class="text-[#1E1414]" />
        </a>

        <QuickContactModal
          triggerClass="pill-btn-outline !text-sm sm:!text-base !px-8 !py-4 w-full sm:w-auto flex items-center justify-center gap-3 cursor-pointer"
        />
      </div>

      <div class="pt-6 sm:pt-8 border-t-2 border-dashed border-[#1E1414]/15 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs text-[#623A2D]/75 font-semibold">
        <span class="flex items-center gap-2">
          <Icon name="zap" size={15} class="text-[#D09AFC]" />
          Відповідь до 15 хвилин
        </span>
        <span class="flex items-center gap-2">
          <Icon name="shield-check" size={15} class="text-[#E8BA98]" />
          Конфіденційність ідеї
        </span>
        <span class="flex items-center gap-2">
          <Icon name="handshake" size={15} class="text-[#FAC3C8]" />
          Безкоштовна консультація
        </span>
      </div>
    </div>
  </div>
</section>
