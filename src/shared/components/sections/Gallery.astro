---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
 photos: string[];
 title?: string;
 format?: '16:9' | '9:16';
 class?: string;
}

const {
 photos,
 title = 'Галерея проєкту',
 format = '16:9',
 class: className = '',
} = Astro.props;

const isVertical = format === '9:16';
const initialCount = isVertical ? 4 : 3;
const hasMore = photos.length > initialCount;
const remainingCount = photos.length - initialCount;
---

{photos.length > 0 && (
 <section
 id="project-gallery"
 class:list={['w-full relative', className]}
 aria-label={title}
 data-photos={JSON.stringify(photos)}
 data-remaining={remainingCount}
 >
 <Card class="space-y-6">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-3">
 <SectionHeader title={title} class="" />
 <span class="px-4 py-1 bg-[#F4E8E3] border border-[#1E1414]/30 text-[#1E1414] rounded-full text-xs font-black" role="status">
 {photos.length} фото
 </span>
 </div>
 </div>

 {/* Responsive grid tailored to format (16:9 horizontal vs 9:16 vertical mobile screenshots) */}
 <div class={`grid gap-6 sm:gap-8 ${isVertical ? 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'}`} role="list">
 {photos.map((photoUrl, index) => {
 const isHidden = index >= initialCount;
 return (
 <div
 class={`rounded-2xl overflow-hidden border-2 border-[#1E1414] bg-[#F4E8E3]/40 transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none group cursor-pointer relative gallery-item ${isVertical ? 'aspect-[9/16]' : 'aspect-[16/10]'} flex items-center justify-center ${isHidden ? 'hidden gallery-hidden' : ''}`}
 role="listitem"
 data-url={photoUrl}
 data-index={index}
 >
 <img
 src={photoUrl}
 alt={`Фото ${index + 1} з ${photos.length}`}
 class="w-full h-full object-cover object-top block transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
 loading="lazy"
 decoding="async"
 />
 <div class="absolute inset-0 bg-black/0 group-hover:bg-black/15 transition-colors duration-300 flex items-end p-3 pointer-events-none">
 <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/95 backdrop-blur-xs text-[#2A1E1E] text-[10px] font-black px-3 py-1 rounded-full shadow-xs">
 Збільшити <Icon name="maximize" size={12} class="ml-1" />
 </span>
 </div>
 </div>
 );
 })}
 </div>

 {hasMore && (
 <div class="pt-2">
 <button
 id="gallery-toggle-btn"
 type="button"
 class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border-2 border-[#1E1414]/60 bg-[#F4E8E3] hover:border-[#1E1414] hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] text-[#1E1414] text-sm font-bold transition-[translate,box-shadow,border-color] duration-200 cursor-pointer motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
 >
 <span id="gallery-toggle-text">Показати решту фото ({remainingCount})</span>
 <Icon name="chevron-down" id="gallery-toggle-icon" size={14} class="transition-transform duration-300" />
 </button>
 </div>
 )}
 </Card>

 {/* Lightbox Modal */}
 <div id="gallery-lightbox" class="fixed inset-0 z-[9999] bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-8">
 <button id="lightbox-close" class="absolute top-6 right-6 text-paper-white text-xl w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Закрити">
 <Icon name="x" size={20} />
 </button>
 
 <button id="lightbox-prev" class="absolute left-4 sm:left-8 text-paper-white text-lg w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Попереднє">
 <Icon name="chevron-left" size={20} />
 </button>

 <button id="lightbox-next" class="absolute right-4 sm:right-8 text-paper-white text-lg w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Наступне">
 <Icon name="chevron-right" size={20} />
 </button>

 <div class="max-w-5xl max-h-[85vh] overflow-hidden flex items-center justify-center relative">
 <img id="lightbox-img" src="" alt="Збільшене фото" class="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl" />
 </div>
 </div>
 </section>
)}

<style>
 /* Lightbox entrance: the overlay fades and the image scales in from 0.96 —
 the same language as the ReviewsMasonry lightbox, so both fullscreen
 surfaces on the site behave identically (occasional surface, standard
 motion; exits stay faster than entrances). */
 #gallery-lightbox {
 opacity: 0;
 transition: opacity 0.2s var(--ease-out-expo);
 }
 #gallery-lightbox.is-open {
 opacity: 1;
 }
 #lightbox-img {
 opacity: 0;
 scale: 0.96;
 transition:
 opacity 0.24s var(--ease-out-expo),
 scale 0.24s var(--ease-out-expo);
 }
 #gallery-lightbox.is-open #lightbox-img {
 opacity: 1;
 scale: 1;
 }
 @media (prefers-reduced-motion: reduce) {
 #gallery-lightbox,
 #lightbox-img {
 transition: none;
 }
 }
</style>

<script>
 function setupGallery() {
 const gallerySection = document.getElementById('project-gallery');
 if (!gallerySection) return;

 const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

 let photos: string[] = [];
 try {
 photos = JSON.parse(gallerySection.getAttribute('data-photos') || '[]');
 } catch {
 photos = [];
 }
 const remainingCount = gallerySection.getAttribute('data-remaining') || '0';

 let currentIndex = 0;
 const lightbox = document.getElementById('gallery-lightbox');
 const lightboxImg = document.getElementById('lightbox-img');
 const closeBtn = document.getElementById('lightbox-close');
 const prevBtn = document.getElementById('lightbox-prev');
 const nextBtn = document.getElementById('lightbox-next');
 const toggleBtn = document.getElementById('gallery-toggle-btn');
 const toggleText = document.getElementById('gallery-toggle-text');
 const toggleIcon = document.getElementById('gallery-toggle-icon');
 const hiddenItems = gallerySection.querySelectorAll('.gallery-hidden');

 let isExpanded = false;
 // Pending async steps of the expand/collapse choreography: a quick
 // re-toggle must cancel them, or a stale timer hides items mid-fade.
 let collapseTimer: number | undefined;
 let closeTimer: number | undefined;

 if (toggleBtn) {
 // Remove any existing clone listeners by cloning node or replacing listener
 const newToggleBtn = toggleBtn.cloneNode(true);
 toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

 const currentToggleText = document.getElementById('gallery-toggle-text');
 const currentToggleIcon = document.getElementById('gallery-toggle-icon');

 newToggleBtn.addEventListener('click', () => {
 isExpanded = !isExpanded;
 window.clearTimeout(collapseTimer);
 window.clearTimeout(closeTimer);

 hiddenItems.forEach((item) => {
 const el = item as HTMLElement;

 if (REDUCED) {
 // Reduced motion: swap visibility instantly, keep opacity feedback.
 el.classList.toggle('hidden', !isExpanded);
 el.style.transition = '';
 el.style.opacity = '';
 el.style.transform = '';
 return;
 }

 if (isExpanded) {
 el.classList.remove('hidden');
 el.style.transition = 'none';
 el.style.opacity = '0';
 el.style.transform = 'translateY(10px)';
 const reveal = () => {
 el.style.transition = 'opacity 0.32s var(--ease-out-expo), transform 0.32s var(--ease-out-expo)';
 el.style.opacity = '1';
 el.style.transform = 'translateY(0)';
 };
 requestAnimationFrame(() => requestAnimationFrame(reveal));
 // rAF-fallback: у webview без анімаційного годинника reveal має
 // статися через таймер, інакше фото залишаться невидимими.
 window.setTimeout(reveal, 60);
 } else {
 el.style.transition = 'opacity 0.2s var(--ease-out-expo), transform 0.2s var(--ease-out-expo)';
 el.style.opacity = '0';
 el.style.transform = 'translateY(10px)';
 collapseTimer = window.setTimeout(() => {
 el.classList.add('hidden');
 el.style.transition = '';
 el.style.opacity = '';
 el.style.transform = '';
 }, 200);
 }
 });

 if (isExpanded) {
 if (currentToggleText) currentToggleText.textContent = 'Згорнути назад';
 if (currentToggleIcon) currentToggleIcon.classList.add('rotate-180');
 } else {
 if (currentToggleText) currentToggleText.textContent = `Показати решту фото (${remainingCount})`;
 if (currentToggleIcon) currentToggleIcon.classList.remove('rotate-180');
 (newToggleBtn as HTMLElement).scrollIntoView({ behavior: REDUCED ? 'auto' : 'smooth', block: 'nearest' });
 }
 });
 }

 function openLightbox(url: string, index: number) {
 currentIndex = index;
 if (lightbox && lightboxImg) {
 (lightboxImg as HTMLImageElement).src = url;
 window.clearTimeout(closeTimer);
 lightbox.classList.remove('hidden');
 lightbox.classList.add('flex');
 document.body.style.overflow = 'hidden';
 // Двофазний rAF: display спочатку, потім is-open — інакше opacity
 // перейде в 1 без переходу ще до появи оверлея. setTimeout-fallback —
 // для webview із замороженим rAF (той самий патерн, що й у Drawer).
 requestAnimationFrame(() => lightbox.classList.add('is-open'));
 window.setTimeout(() => lightbox.classList.add('is-open'), 60);
 }
 }

 function closeLightbox() {
 if (!lightbox) return;
 document.body.style.overflow = '';
 if (REDUCED || lightbox.classList.contains('hidden')) {
 lightbox.classList.add('hidden');
 lightbox.classList.remove('flex', 'is-open');
 return;
 }
 lightbox.classList.remove('is-open');
 // Вихід швидший за вхід; ховаємо display лише після відпрацьованого fade.
 closeTimer = window.setTimeout(() => {
 lightbox.classList.add('hidden');
 lightbox.classList.remove('flex');
 }, 180);
 }

 function showPhoto(index: number) {
 if (!photos.length) return;
 if (index < 0) currentIndex = photos.length - 1;
 else if (index >= photos.length) currentIndex = 0;
 else currentIndex = index;

 if (lightboxImg) {
 (lightboxImg as HTMLImageElement).src = photos[currentIndex];
 }
 }

 gallerySection.querySelectorAll('.gallery-item[data-url]').forEach((item) => {
 item.addEventListener('click', () => {
 const url = item.getAttribute('data-url') || '';
 const idx = parseInt(item.getAttribute('data-index') || '0', 10);
 openLightbox(url, idx);
 });
 });

 if (closeBtn) closeBtn.onclick = closeLightbox;
 if (lightbox) {
 lightbox.onclick = (e) => {
 if (e.target === lightbox) closeLightbox();
 };
 }
 if (prevBtn) prevBtn.onclick = (e) => { e.stopPropagation(); showPhoto(currentIndex - 1); };
 if (nextBtn) nextBtn.onclick = (e) => { e.stopPropagation(); showPhoto(currentIndex + 1); };

 // Keydown handler
 const handleKeydown = (e: KeyboardEvent) => {
 if (!lightbox || lightbox.classList.contains('hidden')) return;
 if (e.key === 'Escape') closeLightbox();
 if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
 if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
 };
 document.removeEventListener('keydown', handleKeydown);
 document.addEventListener('keydown', handleKeydown);
 }

 document.addEventListener('astro:page-load', setupGallery);
 setupGallery();
</script>
