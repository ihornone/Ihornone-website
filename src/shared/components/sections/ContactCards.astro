---
import Icon from "../ui/Icon.astro";

interface ContactLink {
 icon: string;
 title: string;
 value: string;
 href: string;
 external?: boolean;
}

interface Props {
 contacts?: ContactLink[];
 class?: string;
}

const defaultContacts: ContactLink[] = [
 {
 icon: '/icons/telegram.svg',
 title: 'Telegram',
 value: '@ihornone',
 href: 'https://t.me/ihornone',
 external: true,
 },
 {
 icon: '/icons/gmail-2026.svg',
 title: 'Email',
 value: 'hello@ihornone.site',
 href: 'mailto:hello@ihornone.site',
 },
 {
 icon: '/icons/github-dark.svg',
 title: 'GitHub',
 value: 'ihornone',
 href: 'https://github.com/ihornone',
 external: true,
 },
];

const {
 contacts = defaultContacts,
 class: className = '',
} = Astro.props;
---

<div class={`grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 w-full ${className}`} data-animate="fade-up" data-stagger>
 {contacts.map((contact) => (
 <a
 href={contact.href}
 class="bg-white border-2 border-[#1E1414] rounded-3xl p-4 sm:p-6 flex items-center gap-4 hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] transition-[translate,box-shadow] duration-200 motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none no-underline group"
 {...(contact.external ? { target: '_blank', rel: 'noopener' } : {})}
 >
 <div class="w-12 h-12 bg-[#F4E8E3] border-2 border-[#1E1414] rounded-full flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105 motion-reduce:transition-none">
 <img src={contact.icon} alt="" class="w-6 h-6" loading="lazy" />
 </div>
 <div class="flex-grow min-w-0">
 <h3 class="text-sm font-black text-[#1E1414] group-hover:text-[#95553C] transition-colors">
 {contact.title}
 </h3>
 <p class="text-xs text-[#623A2D]/80 font-bold truncate ">
 {contact.value}
 </p>
 </div>
 <Icon name="arrow-right" size={14} class="text-[#2A1E1E]/40 group-hover:text-[#95553C] group-hover:translate-x-1 transition-all" />
 </a>
 ))}
</div>
