---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import MokiWidget from '../moki/MokiWidget.astro';

export interface FaqItem {
 question: string;
 answer: string;
 badge?: string;
}

interface Props {
 title?: string;
 items?: FaqItem[];
 showHeader?: boolean;
 class?: string;
}

const defaultItems: FaqItem[] = [
 {
 question: 'Скільки часу займає розробка Telegram-бота чи сайту?',
 answer: 'Зазвичай розробка базового сайту або бота займає від 1 до 2 тижнів. Складні проєкти з інтеграціями CRM та платежами розробляються за 3-4 тижні.',
 badge: 'Загальне',
 },
 {
 question: 'Які платіжні системи можна підключити?',
 answer: 'Можна підключити Monobank, LiqPay, Stripe, WayForPay, Telegram Payments або криптовалютні еквайринги.',
 badge: 'Оплата',
 },
 {
 question: 'Чи надаєте ви підтримку після запуску?',
 answer: 'Так, я надаю безкоштовний період технічної підтримки та гарантії на відсутність багів після релізу.',
 badge: 'Підтримка',
 },
 {
 question: 'Як відбувається процес оплати та співпраці?',
 answer: 'Робота розбивається на етапи. Звичайний порядок: 50% передоплата на початку робіт, та 50% після демонстрації готового проєкту та вашого схвалення.',
 badge: 'Оплата',
 },
];

const {
 title = 'Часті запитання',
 items = defaultItems,
 showHeader = true,
 class: className = '',
} = Astro.props;
---

<div class={`space-y-8 w-full ${className}`}>
 {showHeader && title && (
   <div class="flex items-center justify-center gap-3 sm:gap-4 mb-8">
     <SectionHeader title={title} align="center" />
     <div class="shrink-0 -mt-2 moki-float" style="animation-delay:-4.2s">
       <MokiWidget
         size={85}
         expression="curieux"
         color="#D09AFC"
         shape="galet"
         follow="page"
       />
     </div>
   </div>
 )}

 <div class="space-y-8 w-full faq-container" data-animate="fade-up" data-stagger>
 {items.map((item, index) => (
 <details
 name="faq-accordion"
 class="group relative bg-white border-2 border-[#1E1414] rounded-3xl transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_0_#D09AFC] [&[open]]:shadow-[0_8px_0_#FAC3C8] cursor-pointer overflow-visible faq-item motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
 >
 <summary class="w-full p-6 sm:p-6 md:px-8 font-black text-base sm:text-xl text-[#1E1414] flex items-center gap-4 select-none list-none leading-snug cursor-pointer">
 <span class="hidden sm:grid size-10 shrink-0 place-items-center rounded-full bg-[#1E1414] text-sm font-black text-white">
 {index + 1}
 </span>
 <span class="group-hover:text-[#95553C] transition-colors flex-1">{item.question}</span>
 <span class="size-10 rounded-full border-2 border-[#1E1414] bg-white grid place-items-center shrink-0 transition-colors group-hover:bg-[#D09AFC]">
 <Icon name="chevron-right" size={14} class="group-open:rotate-90 transition-transform duration-300 motion-reduce:transition-none" />
 </span>
 </summary>
 <div class="faq-item-grid">
 <div class="faq-item-inner">
 <div
 class="faq-answer-content px-6 sm:px-8 pb-6 text-sm sm:text-base text-[#623A2D]/85 font-medium leading-relaxed border-t-2 border-dashed border-[#1E1414]/15 pt-4 cursor-auto select-text"
 set:html={item.answer}
 />
 </div>
 </div>
 </details>
 ))}
 </div>
</div>

<script>
 function initFaqClicks() {
 document.querySelectorAll<HTMLDetailsElement>('details.faq-item').forEach((details) => {
 details.addEventListener('click', (e) => {
 const target = e.target as HTMLElement;
 if (!target) return;

 // If clicked on a link or button, do not toggle
 if (target.closest('a, button')) return;

 // If clicking on summary itself, native HTML handles it
 if (target.closest('summary')) return;

 // If details is already open and clicked inside the answer text (e.g. text selection), do not toggle
 if (details.open && target.closest('.faq-answer-content')) return;

 // Otherwise (clicked anywhere on card padding, borders, or header area), toggle via summary
 const summary = details.querySelector('summary');
 summary?.click();
 });
 });
 }

 initFaqClicks();
 document.addEventListener('astro:page-load', initFaqClicks);
</script>
