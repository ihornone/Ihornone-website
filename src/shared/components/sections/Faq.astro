---
import SectionHeader from '../ui/SectionHeader.astro';

export interface FaqItem {
  question: string;
  answer: string;
  badge?: string;
}

interface Props {
  title?: string;
  items?: FaqItem[];
  showHeader?: boolean;
  class?: string;
}

const defaultItems: FaqItem[] = [
  {
    question: 'Скільки часу займає розробка Telegram-бота чи сайту?',
    answer: 'Зазвичай розробка базового сайту або бота займає від 1 до 2 тижнів. Складні проєкти з інтеграціями CRM та платежами розробляються за 3-4 тижні.',
    badge: 'Загальне',
  },
  {
    question: 'Які платіжні системи можна підключити?',
    answer: 'Можна підключити Monobank, LiqPay, Stripe, WayForPay, Telegram Payments або криптовалютні еквайринги.',
    badge: 'Оплата',
  },
  {
    question: 'Чи надаєте ви підтримку після запуску?',
    answer: 'Так, я надаю безкоштовний період технічної підтримки та гарантії на відсутність багів після релізу.',
    badge: 'Підтримка',
  },
  {
    question: 'Як відбувається процес оплати та співпраці?',
    answer: 'Робота розбивається на етапи. Звичайний порядок: 50% передоплата на початку робіт, та 50% після демонстрації готового проєкту та вашого схвалення.',
    badge: 'Оплата',
  },
];

const {
  title = 'Часті запитання',
  items = defaultItems,
  showHeader = true,
  class: className = '',
} = Astro.props;
---

<div class={`space-y-6 w-full ${className}`}>
  {showHeader && title && (
    <SectionHeader title={title} align="center" />
  )}

  <div class="space-y-4 w-full faq-container" data-animate="fade-up" data-stagger>
    {items.map((item) => (
      <details
        name="faq-accordion"
        class="group bg-white border border-[#623A2D]/10 rounded-[20px] shadow-[0_12px_28px_rgba(42,30,30,0.04)] [&[open]]:border-[#FAC3C8] hover:border-[#FAC3C8]/80 hover:shadow-[0_16px_36px_rgba(42,30,30,0.08)] transition-all duration-300 cursor-pointer overflow-hidden faq-item"
      >
        <summary class="w-full p-6 sm:p-7 font-black text-base sm:text-xl text-[#2A1E1E] flex items-center justify-between gap-4 select-none list-none leading-snug cursor-pointer">
          <span class="group-hover:text-[#95553C] transition-colors">{item.question}</span>
          <div class="w-10 h-10 rounded-full bg-[#FAF1EC] border border-[#623A2D]/8 group-hover:bg-[#FAC3C8]/40 flex items-center justify-center shrink-0 transition-colors text-[#2A1E1E] shadow-2xs">
            <i class="fa-solid fa-plus text-sm group-open:rotate-45 transition-transform duration-300"></i>
          </div>
        </summary>
        <div
          class="faq-answer-content px-6 sm:px-7 pb-6 sm:pb-7 text-sm sm:text-base text-[#623A2D]/85 font-medium leading-relaxed m-0 border-t border-[#623A2D]/10 pt-4 cursor-auto select-text"
          set:html={item.answer}
        />
      </details>
    ))}
  </div>
</div>

<script>
  function initFaqClicks() {
    document.querySelectorAll<HTMLDetailsElement>('details.faq-item').forEach((details) => {
      details.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        // If clicked on a link or button, do not toggle
        if (target.closest('a, button')) return;

        // If clicking on summary itself, native HTML handles it
        if (target.closest('summary')) return;

        // If details is already open and clicked inside the answer text (e.g. text selection), do not toggle
        if (details.open && target.closest('.faq-answer-content')) return;

        // Otherwise (clicked anywhere on card padding, borders, or header area), toggle via summary
        const summary = details.querySelector('summary');
        summary?.click();
      });
    });
  }

  initFaqClicks();
  document.addEventListener('astro:page-load', initFaqClicks);
</script>
