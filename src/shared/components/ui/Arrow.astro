---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- Circular outline arrow used by text links (unlimited-style "Read more ↗") -->
<svg
  class:list={['size-7 shrink-0', className]}
  viewBox="0 0 26 26"
  fill="none"
  aria-hidden="true"
>
  <circle cx="13" cy="13" r="12.4" stroke="currentColor" stroke-width="1.2"></circle>
  <path
    d="M9.5 16.5 L16.5 9.5 M10.2 9.5 H16.5 V15.8"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
