---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'accent' | 'muted';
  class?: string;
}

const {
  icon,
  size = 'md',
  variant = 'default',
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-9 h-9',
  md: 'w-11 h-11',
  lg: 'w-14 h-14',
};

const iconSizes = {
  sm: 18,
  md: 22,
  lg: 28,
};

const variantClasses = {
  default: 'bg-white text-[#2A1E1E] border-2 border-[#1E1414]',
  accent: 'bg-[#D09AFC] text-[#1E1414] border-2 border-[#1E1414]',
  muted: 'bg-[#F4E8E3] text-[#623A2D] border-2 border-[#1E1414]/40',
};

const baseClasses = 'rounded-xl flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 motion-reduce:transition-none motion-reduce:group-hover:scale-100 motion-reduce:group-hover:rotate-0';
---

<div class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}>
  <Icon name={icon} size={iconSizes[size]} />
</div>
