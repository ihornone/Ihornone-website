---
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'outline' | 'dark' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  disabled?: boolean;
  loading?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  ariaLabel?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
  loading = false,
  icon,
  iconPosition = 'right',
  ariaLabel,
  target,
  rel,
} = Astro.props;

const isDisabled = disabled || loading;

const variantClasses = {
  primary: 'border-2 border-[#1E1414] bg-[#1E1414] text-white hover:-translate-y-1 hover:shadow-[0_10px_0_#D09AFC] active:translate-y-0 focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  outline: 'border-2 border-[#1E1414]/60 bg-[#FAF1EC]/60 text-[#2A1E1E] hover:border-[#1E1414] hover:-translate-y-1 hover:shadow-[0_10px_0_#D09AFC] active:translate-y-0 focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  dark: 'border-2 border-[#1E1414] bg-[#1E1414] text-white hover:-translate-y-1 hover:shadow-[0_10px_0_#D09AFC] active:translate-y-0 focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  ghost: 'bg-transparent text-[#2A1E1E] hover:bg-[#F4E8E3] focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  accent: 'border-2 border-[#1E1414] bg-[#D09AFC] text-[#1E1414] hover:-translate-y-1 hover:shadow-[0_10px_0_#1E1414] active:translate-y-0 focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
};

const sizeClasses = {
  sm: '!py-2 !px-4 !text-xs',
  md: '!py-3 !px-6 !text-sm',
  lg: '!py-4 !px-8 !text-base',
};

const baseClasses = 'inline-flex items-center justify-center gap-2 rounded-2xl font-sans font-bold transition-[translate,box-shadow,background-color,border-color] duration-200 cursor-pointer no-underline outline-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none';
---

{href ? (
  <a
    href={href}
    target={target}
    rel={rel || (target === '_blank' ? 'noopener noreferrer' : undefined)}
    data-magnetic={isDisabled ? undefined : '6'}
    class={`${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${isDisabled ? 'opacity-50 pointer-events-none' : ''} press-feedback ${className}`}
    aria-label={ariaLabel}
    aria-disabled={isDisabled}
    tabindex={isDisabled ? -1 : 0}
  >
    {loading ? (
      <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    ) : (
      icon && iconPosition === 'left' && <Icon name={icon} size={15} class="btn-icon" />
    )}
    <slot />
    {!loading && icon && iconPosition === 'right' && <Icon name={icon} size={15} class="btn-icon" />}
  </a>
) : (
  <button
    type={type}
    disabled={isDisabled}
    data-magnetic={isDisabled ? undefined : '6'}
    class={`${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${isDisabled ? 'opacity-50 cursor-not-allowed' : ''} press-feedback ${className}`}
    aria-label={ariaLabel}
    aria-busy={loading}
    aria-disabled={isDisabled}
  >
    {loading ? (
      <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    ) : (
      icon && iconPosition === 'left' && <Icon name={icon} size={15} class="btn-icon" />
    )}
    <slot />
    {!loading && icon && iconPosition === 'right' && <Icon name={icon} size={15} class="btn-icon" />}
  </button>
)}
