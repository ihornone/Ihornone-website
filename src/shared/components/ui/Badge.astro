---
import Icon from './Icon.astro';

interface Props {
  variant?: 'default' | 'accent' | 'success' | 'muted';
  icon?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'default',
  icon,
  class: className = '',
  ariaLabel,
} = Astro.props;

const variantClasses = {
  default: 'bg-[#E8BA98] text-[#1E1414]',
  accent: 'bg-[#D09AFC] text-[#1E1414]',
  pink: 'bg-[#FAC3C8] text-[#1E1414]',
  success: 'bg-[#D09AFC]/20 text-[#2A1E1E] border border-[#1E1414]/20',
  muted: 'bg-[#F4E8E3] text-[#623A2D] border border-[#1E1414]/20',
};

const baseClasses = 'inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider';
---

<span class:list={[baseClasses, variantClasses[variant], className]} role={ariaLabel ? 'status' : undefined} aria-label={ariaLabel}>
  {icon && <Icon name={icon} size={13} />}
  <slot />
</span>
