---
interface Props {
  variant?: 'default' | 'highlight' | 'flat';
  padding?: 'sm' | 'md' | 'lg';
  hover?: boolean;
  as?: 'div' | 'article' | 'section' | 'aside';
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  as: Tag = 'div',
  class: className = '',
  ...rest
} = Astro.props;

const variantClasses = {
  default: 'bg-white border-2 border-[#1E1414]',
  highlight: 'bg-white border-2 border-[#D09AFC]',
  flat: 'bg-[#F4E8E3] border-2 border-[#1E1414]/70',
};

const paddingClasses = {
  sm: 'p-4 sm:p-6',
  md: 'p-6 sm:p-6 md:p-8',
  lg: 'p-6 sm:p-8 md:p-8',
};

const baseClasses = 'rounded-3xl transition-[translate,box-shadow,border-color] duration-200 motion-reduce:transition-none';
const hoverClasses = hover ? 'hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none' : '';
---

<Tag class:list={[baseClasses, variantClasses[variant], paddingClasses[padding], hoverClasses, className]} {...rest}>
  <slot />
</Tag>
