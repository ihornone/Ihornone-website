---
import React from 'react';
import {
  ArrowRight,
  ArrowLeft,
  ArrowUpRight,
  ExternalLink,
  ChevronDown,
  ChevronUp,
  ChevronLeft,
  ChevronRight,
  X,
  Menu,
  Maximize2,
  MoreHorizontal,
  Check,
  CheckCircle2,
  CheckSquare,
  AlertTriangle,
  Star,
  Heart,
  Clock,
  History,
  Cat,
  Zap,
  ShieldCheck,
  Shield,
  Lock,
  Key,
  Handshake,
  Cpu,
  Code2,
  Code,
  GitBranch,
  Database,
  Server,
  Bot,
  Bug,
  BugOff,
  Wand2,
  Sparkles,
  Boxes,
  Store,
  ShoppingBag,
  ShoppingCart,
  Palette,
  Network,
  LayoutGrid,
  Columns,
  Globe,
  Smartphone,
  CreditCard,
  Wallet,
  TrendingUp,
  PieChart,
  Brain,
  Cloud,
  CloudUpload,
  MessageSquare,
  Mail,
  Send,
  PenTool,
  Ruler,
  Rocket,
  User,
  UserCheck,
  Stethoscope,
  Smile,
  Sliders,
  Timer,
  CalendarCheck,
  Calendar,
  Search,
  Bell,
  Settings,
  FlaskConical,
  Film,
  Image,
  FileText,
  Coffee,
  Home,
  Plug,
  AppWindow,
  RefreshCw,
  ArrowLeftRight,
  HelpCircle,
  Atom,
  Coins,
  Layers,
  type LucideIcon,
} from 'lucide-react';

interface Props {
  name?: string;
  icon?: string;
  class?: string;
  className?: string;
  size?: number | string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
  id?: string;
}

const {
  name,
  icon,
  class: classProp = '',
  className: classNameProp = '',
  size = 18,
  strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  id,
} = Astro.props;

const rawName = (name || icon || '').trim();

// Map of names to Lucide icons
const iconMap: Record<string, LucideIcon> = {
  // Navigation & UI
  arrowright: ArrowRight,
  'arrow-right': ArrowRight,
  arrowleft: ArrowLeft,
  'arrow-left': ArrowLeft,
  arrowupright: ArrowUpRight,
  'arrow-up-right': ArrowUpRight,
  externallink: ExternalLink,
  'external-link': ExternalLink,
  chevrondown: ChevronDown,
  'chevron-down': ChevronDown,
  chevronup: ChevronUp,
  'chevron-up': ChevronUp,
  chevronleft: ChevronLeft,
  'chevron-left': ChevronLeft,
  chevronright: ChevronRight,
  'chevron-right': ChevronRight,
  x: X,
  xmark: X,
  menu: Menu,
  bars: Menu,
  maximize: Maximize2,
  maximize2: Maximize2,
  expand: Maximize2,
  ellipsis: MoreHorizontal,
  morehorizontal: MoreHorizontal,
  check: Check,
  checkcircle: CheckCircle2,
  'circle-check': CheckCircle2,
  checksquare: CheckSquare,
  'square-check': CheckSquare,
  alerttriangle: AlertTriangle,
  'triangle-exclamation': AlertTriangle,
  star: Star,
  heart: Heart,
  clock: Clock,
  history: History,
  'clock-rotate-left': History,
  cat: Cat,
  zap: Zap,
  bolt: Zap,
  shield: Shield,
  shieldcheck: ShieldCheck,
  'shield-check': ShieldCheck,
  'shield-halved': ShieldCheck,
  lock: Lock,
  key: Key,
  handshake: Handshake,
  code: Code,
  code2: Code2,
  cpu: Cpu,
  gitbranch: GitBranch,
  'code-branch': GitBranch,
  database: Database,
  server: Server,
  bot: Bot,
  robot: Bot,
  bug: Bug,
  bugoff: BugOff,
  'bug-slash': BugOff,
  wand2: Wand2,
  sparkles: Sparkles,
  'wand-magic-sparkles': Sparkles,
  'hand-sparkles': Sparkles,
  boxes: Boxes,
  'boxes-stacked': Boxes,
  store: Store,
  shoppingbag: ShoppingBag,
  'bag-shopping': ShoppingBag,
  shoppingcart: ShoppingCart,
  'cart-shopping': ShoppingCart,
  palette: Palette,
  network: Network,
  'network-wired': Network,
  layoutgrid: LayoutGrid,
  'table-columns': LayoutGrid,
  columns: Columns,
  globe: Globe,
  'earth-europe': Globe,
  smartphone: Smartphone,
  'mobile-screen-button': Smartphone,
  creditcard: CreditCard,
  'credit-card': CreditCard,
  wallet: Wallet,
  trendingup: TrendingUp,
  'chart-line': TrendingUp,
  piechart: PieChart,
  'chart-pie': PieChart,
  brain: Brain,
  cloud: Cloud,
  cloudupload: CloudUpload,
  'cloud-arrow-up': CloudUpload,
  messagesquare: MessageSquare,
  comments: MessageSquare,
  mail: Mail,
  envelope: Mail,
  send: Send,
  'paper-plane': Send,
  pentool: PenTool,
  'pen-ruler': PenTool,
  ruler: Ruler,
  user: User,
  usercheck: UserCheck,
  'user-check': UserCheck,
  rocket: Rocket,
  stethoscope: Stethoscope,
  'user-doctor': Stethoscope,
  tooth: Smile,
  smile: Smile,
  sliders: Sliders,
  timer: Timer,
  stopwatch: Timer,
  calendarcheck: CalendarCheck,
  'calendar-check': CalendarCheck,
  'calendar-heart': Calendar,
  calendar: Calendar,
  search: Search,
  'magnifying-glass': Search,
  bell: Bell,
  settings: Settings,
  gear: Settings,
  gears: Settings,
  flaskconical: FlaskConical,
  flask: FlaskConical,
  film: Film,
  image: Image,
  images: Image,
  filetext: FileText,
  'file-pdf': FileText,
  coffee: Coffee,
  'mug-hot': Coffee,
  home: Home,
  house: Home,
  plug: Plug,
  appwindow: AppWindow,
  'window-maximize': AppWindow,
  refreshcw: RefreshCw,
  'arrows-spin': RefreshCw,
  arrowleftright: ArrowLeftRight,
  'arrows-left-right': ArrowLeftRight,
  helpcircle: HelpCircle,
  'circle-question': HelpCircle,
  'clipboard-question': HelpCircle,
  'list-check': CheckSquare,
  'trowel-bricks': LayoutGrid,
  coins: Coins,
  layers: Layers,
  'layer-group': Layers,
  react: Atom,
  atom: Atom,
};

// Clean raw input (extract icon name from fa classes e.g. "fa-solid fa-arrow-right" -> "arrow-right")
let cleanKey = rawName.toLowerCase();
if (cleanKey.includes('fa-')) {
  const parts = cleanKey.split(/\s+/);
  const faPart = parts.find((p) => p.startsWith('fa-') && p !== 'fa-solid' && p !== 'fa-brands' && p !== 'fa-regular');
  if (faPart) {
    cleanKey = faPart.replace(/^fa-/, '');
  }
}
cleanKey = cleanKey.replace(/^lucide-/, '').trim();

// Specific brand icons (Telegram, GitHub, Instagram, Threads, Android) matching Lucide style (24x24 stroke)
const isTelegram = cleanKey === 'telegram' || cleanKey.includes('telegram');
const isGithub = cleanKey === 'github' || cleanKey.includes('github');
const isInstagram = cleanKey === 'instagram' || cleanKey.includes('instagram');
const isThreads = cleanKey === 'threads' || cleanKey.includes('threads');
const isAndroid = cleanKey === 'android' || cleanKey.includes('android');

const ResolvedLucideIcon = iconMap[cleanKey] || (!isTelegram && !isGithub && !isInstagram && !isThreads && !isAndroid ? Sparkles : null);

const combinedClass = [classProp, classNameProp, 'inline-block shrink-0 align-middle'].filter(Boolean).join(' ');
---

{isTelegram ? (
  <svg
    id={id}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-telegram ${combinedClass}`}
    aria-hidden={ariaHidden ? 'true' : undefined}
  >
    <path d="M21.5 2L2 9.5l6 2.5 2.5 6 3-3.5 4.5 3.5 3.5-16z" />
    <path d="M8 12l10-7-7 8" />
  </svg>
) : isGithub ? (
  <svg
    id={id}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-github ${combinedClass}`}
    aria-hidden={ariaHidden ? 'true' : undefined}
  >
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
    <path d="M9 18c-4.51 2-5-2-7-2" />
  </svg>
) : isInstagram ? (
  <svg
    id={id}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-instagram ${combinedClass}`}
    aria-hidden={ariaHidden ? 'true' : undefined}
  >
    <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
  </svg>
) : isThreads ? (
  <svg
    id={id}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-threads ${combinedClass}`}
    aria-hidden={ariaHidden ? 'true' : undefined}
  >
    <path d="M19.25 12.05c-.14-4.66-3.8-7.8-8.25-7.8-4.94 0-8.75 3.77-8.75 8.75s3.81 8.75 8.75 8.75c3.27 0 6.13-1.67 7.5-4.22" />
    <path d="M15.5 10.5c-.88-1.54-2.52-2.25-4.5-2.25-3 0-5 2-5 4.5s2 4.5 5 4.5c2.5 0 4-1.25 4.5-2.75" />
    <path d="M15.5 10.5v4" />
  </svg>
) : isAndroid ? (
  <svg
    id={id}
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`lucide lucide-android ${combinedClass}`}
    aria-hidden={ariaHidden ? 'true' : undefined}
  >
    <path d="M4 10v6" />
    <path d="M20 10v6" />
    <path d="M7 10v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8" />
    <path d="M8 7a4 4 0 0 1 8 0H8z" />
    <line x1="9" x2="7" y1="4" y2="2" />
    <line x1="15" x2="17" y1="4" y2="2" />
  </svg>
) : ResolvedLucideIcon ? (
  <ResolvedLucideIcon
    id={id}
    size={Number(size) || 18}
    strokeWidth={strokeWidth}
    className={combinedClass}
    aria-hidden={ariaHidden ? 'true' : undefined}
  />
) : null}
