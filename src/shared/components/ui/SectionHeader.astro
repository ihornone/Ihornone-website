---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center max-w-xl mx-auto',
};
---

<div class={`${alignClasses[align]} ${className}`}>
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
    {title}
  </h2>
</div>
