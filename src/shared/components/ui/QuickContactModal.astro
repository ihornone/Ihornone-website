---
import Drawer from './Drawer.astro';

export interface Props {
  triggerText?: string;
  triggerClass?: string;
  id?: string;
}

const {
  triggerText = 'Форма заявки',
  triggerClass = 'pill-btn-outline !text-sm sm:!text-base w-full sm:w-auto flex items-center justify-center gap-2 cursor-pointer',
  id = `contact-drawer-${crypto.randomUUID().slice(0, 8)}`,
} = Astro.props;

const socials = [
  { name: 'Telegram', href: 'https://t.me/ihornone', icon: 'fa-brands fa-telegram text-[#2AABEE]' },
  { name: 'GitHub', href: 'https://github.com/ihornone', icon: 'fa-brands fa-github text-[#181717]' },
  { name: 'Instagram', href: 'https://instagram.com/ihornone', icon: 'fa-brands fa-instagram text-[#E4405F]' },
  { name: 'Threads', href: 'https://threads.net/@ihornone', icon: 'fa-brands fa-threads text-[#000000]' },
  { name: 'Email', href: 'mailto:hello@ihornone.site', icon: 'fa-solid fa-envelope text-[#EA4335]' },
];

const inp =
  'w-full px-4 py-3 bg-[#FAF1EC] rounded-2xl border border-[#623A2D]/10 text-sm text-[#2A1E1E] placeholder:text-[#623A2D]/40 focus:border-[#D09AFC] focus:bg-white outline-none transition-all shadow-xs';

const label = 'block text-[11px] font-black tracking-wider uppercase text-[#2A1E1E] text-left';
---

<button type="button" class={triggerClass} data-drawer-open={id} data-magnetic="6" aria-label="Відкрити швидку заявку">
  <i class="fa-solid fa-envelope text-xs opacity-75"></i>
  <span>{triggerText}</span>
</button>

<Drawer id={id} title="Зв'язатися зі мною">
  <!-- Success screen -->
  <div class="js-success hidden text-center py-10 space-y-4">
    <div class="w-14 h-14 rounded-full bg-[#FAF1EC] border border-[#623A2D]/10 flex items-center justify-center text-2xl mx-auto shadow-2xs">
      <i class="fa-solid fa-check text-emerald-600"></i>
    </div>
    <h3 class="text-xl font-black text-[#2A1E1E] m-0">Повідомлення надіслано!</h3>
    <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium m-0">Я вже отримав вашу заявку та відповім протягом 15 хвилин у робочий час.</p>
    <button type="button" class="js-confirm w-full py-3.5 px-6 rounded-full bg-[#2A1E1E] hover:bg-[#3D2C2C] text-white text-xs font-black mt-4 cursor-pointer transition-colors shadow-xs">
      Чудово
    </button>
  </div>

  <!-- Error screen — запасний шлях, якщо API недоступне -->
  <div class="js-error hidden text-center py-10 space-y-4">
    <div class="w-14 h-14 rounded-full bg-[#FAF1EC] border border-[#623A2D]/10 flex items-center justify-center text-2xl mx-auto shadow-2xs">
      <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
    </div>
    <h3 class="text-xl font-black text-[#2A1E1E] m-0">Не вдалося надіслати</h3>
    <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium m-0">Спробуйте ще раз або напишіть мені напряму — повідомлення вже підготовлено.</p>
    <a
      class="js-telegram-link w-full py-3.5 px-6 rounded-full bg-[#2A1E1E] hover:bg-[#3D2C2C] text-white text-xs font-black mt-4 cursor-pointer transition-colors shadow-xs inline-flex items-center justify-center gap-2 no-underline"
      href="https://t.me/ihornone"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-telegram" aria-hidden="true"></i>
      <span>Написати в Telegram</span>
    </a>
    <button type="button" class="js-retry w-full py-3.5 px-6 rounded-full bg-[#FAF1EC] border border-[#623A2D]/15 text-[#2A1E1E] text-xs font-black cursor-pointer transition-colors">
      Спробувати ще раз
    </button>
  </div>

  <!-- Form and socials -->
  <div class="js-body space-y-6">
    <form class="js-form space-y-5 text-left">
      <div>
        <label class={label} for={`${id}-name`}>ІМ'Я <span class="text-rose-500">*</span></label>
        <input type="text" id={`${id}-name`} name="name" required placeholder="Ваше ім'я" autocomplete="name" class={inp} />
      </div>

      <div>
        <label class={label} for={`${id}-contact`}>ЗРУЧНИЙ ЗВ'ЯЗОК <span class="text-rose-500">*</span></label>
        <input type="text" id={`${id}-contact`} name="contact" required placeholder="Telegram, email або телефон" class={inp} />
      </div>

      <div>
        <label class={label} for={`${id}-message`}>ПОВІДОМЛЕННЯ <span class="text-rose-500">*</span></label>
        <textarea id={`${id}-message`} name="message" rows="3" required placeholder="Коротко опишіть вашу ідею..." class={`${inp} resize-none`}></textarea>
      </div>

      <button type="submit" class="w-full py-3.5 px-6 rounded-full bg-[#2A1E1E] hover:bg-[#3D2C2C] active:scale-[0.99] text-white text-xs sm:text-sm font-black flex items-center justify-center gap-2 cursor-pointer shadow-md transition-all disabled:opacity-50">
        <span>Надіслати заявку</span>
        <i class="fa-solid fa-arrow-right text-[11px]"></i>
      </button>
    </form>

    <div class="pt-2 space-y-3">
      <div class="text-center">
        <span class="text-[11px] font-black text-[#623A2D]/60 uppercase tracking-widest">СОЦМЕРЕЖІ</span>
      </div>
      <div class="space-y-2">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 px-4 rounded-2xl bg-[#FAF1EC] border border-[#623A2D]/10 hover:border-[#D09AFC] hover:bg-white hover:shadow-sm hover:-translate-y-0.5 transition-all text-[#2A1E1E] no-underline group">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-full bg-white border border-[#623A2D]/10 flex items-center justify-center text-sm shadow-2xs group-hover:border-[#D09AFC] transition-colors">
                <i class={s.icon}></i>
              </div>
              <span class="text-xs sm:text-sm font-bold text-[#2A1E1E]">{s.name}</span>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-[#623A2D]/40 group-hover:text-[#95553C] group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-all"></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</Drawer>

<script>
  function initContactForms() {
    document.querySelectorAll<HTMLElement>('[data-drawer]').forEach((drawer) => {
      const form = drawer.querySelector<HTMLFormElement>('.js-form');
      if (!form || form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const body = drawer.querySelector<HTMLElement>('.js-body');
      const success = drawer.querySelector<HTMLElement>('.js-success');
      const error = drawer.querySelector<HTMLElement>('.js-error');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const telegramLink = drawer.querySelector<HTMLAnchorElement>('.js-telegram-link');

      const show = (screen: 'body' | 'success' | 'error') => {
        if (body) body.classList.toggle('hidden', screen !== 'body');
        if (success) success.classList.toggle('hidden', screen !== 'success');
        if (error) error.classList.toggle('hidden', screen !== 'error');
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitBtn) submitBtn.disabled = true;

        const data = new FormData(form);
        const res = await fetch('/api/contact', { method: 'POST', body: data }).catch(() => null);

        if (submitBtn) submitBtn.disabled = false;

        if (!res?.ok) {
          // window.open після await блокується popup-блокатором, тому
          // готуємо посилання, яке відкриє вже користувач.
          const text = encodeURIComponent(
            `Привіт! Мене звати ${data.get('name')}. Контакт: ${data.get('contact')}. Повідомлення: ${data.get('message')}`
          );
          if (telegramLink) telegramLink.href = `https://t.me/ihornone?text=${text}`;
          show('error');
          return;
        }

        form.reset();
        show('success');
      });

      drawer.querySelector<HTMLElement>('.js-confirm')?.addEventListener('click', () => {
        show('body');
        form.reset();
      });

      drawer.querySelector<HTMLElement>('.js-retry')?.addEventListener('click', () => show('body'));
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
