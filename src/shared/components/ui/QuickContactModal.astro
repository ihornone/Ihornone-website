---
import Drawer from './Drawer.astro';
import Icon from './Icon.astro';

export interface Props {
 triggerText?: string;
 triggerClass?: string;
 id?: string;
}

const {
 triggerText = 'Форма заявки',
 triggerClass = 'pill-btn-outline !text-sm sm:!text-base w-full sm:w-auto flex items-center justify-center gap-2 cursor-pointer',
 id = `contact-drawer-${crypto.randomUUID().slice(0, 8)}`,
} = Astro.props;

const socials = [
 { name: 'Telegram', href: 'https://t.me/ihornone', icon: 'telegram', color: 'text-[#2AABEE]' },
 { name: 'GitHub', href: 'https://github.com/ihornone', icon: 'github', color: 'text-[#181717]' },
 { name: 'Instagram', href: 'https://instagram.com/ihornone', icon: 'instagram', color: 'text-[#E4405F]' },
 { name: 'Threads', href: 'https://threads.net/@ihornone', icon: 'threads', color: 'text-[#000000]' },
 { name: 'Email', href: 'mailto:hello@ihornone.site', icon: 'envelope', color: 'text-[#EA4335]' },
];

const inp =
 'w-full px-4 py-3 bg-[#FAF1EC] rounded-xl border-2 border-[#1E1414]/25 text-sm text-[#1E1414] placeholder:text-[#623A2D]/40 focus:border-[#D09AFC] focus:bg-white outline-none transition-[background-color,border-color]';

const label = 'block text-[11px] font-black tracking-wider uppercase text-[#2A1E1E] text-left';
---

<button type="button" class={triggerClass} data-drawer-open={id} data-magnetic="6" aria-label="Відкрити швидку заявку">
 <Icon name="envelope" size={14} class="opacity-75" />
 <span>{triggerText}</span>
</button>

<Drawer id={id} title="Зв'язатися зі мною">
 <!-- Success screen -->
 <div class="js-success hidden text-center py-8 space-y-4">
 <div class="w-14 h-14 rounded-full bg-[#F4E8E3] border-2 border-[#1E1414] flex items-center justify-center text-2xl mx-auto">
 <Icon name="check" size={24} class="text-[#95553C]" />
 </div>
 <h3 class="text-xl font-black text-[#1E1414] ">Повідомлення надіслано!</h3>
 <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium ">Я вже отримав вашу заявку та відповім протягом 15 хвилин у робочий час.</p>
 <button type="button" class="js-confirm w-full py-4 px-6 rounded-xl border-2 border-[#1E1414] bg-[#1E1414] text-white text-xs font-black mt-4 cursor-pointer transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none">
 Чудово
 </button>
 </div>

 <!-- Error screen — запасний шлях, якщо API недоступне -->
 <div class="js-error hidden text-center py-8 space-y-4">
 <div class="w-14 h-14 rounded-full bg-[#F4E8E3] border-2 border-[#1E1414] flex items-center justify-center text-2xl mx-auto">
 <Icon name="alert-triangle" size={24} class="text-amber-500" />
 </div>
 <h3 class="text-xl font-black text-[#1E1414] ">Не вдалося надіслати</h3>
 <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium ">Спробуйте ще раз або напишіть мені напряму — повідомлення вже підготовлено.</p>
 <a
 class="js-telegram-link w-full py-4 px-6 rounded-xl border-2 border-[#1E1414] bg-[#1E1414] text-white text-xs font-black mt-4 cursor-pointer transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none inline-flex items-center justify-center gap-2 no-underline"
 href="https://t.me/ihornone"
 target="_blank"
 rel="noopener noreferrer"
 >
 <Icon name="telegram" size={16} />
 <span>Написати в Telegram</span>
 </a>
 <button type="button" class="js-retry w-full py-4 px-6 rounded-xl bg-[#FAF1EC] border-2 border-[#1E1414]/40 text-[#1E1414] text-xs font-black cursor-pointer transition-colors hover:border-[#1E1414]">
 Спробувати ще раз
 </button>
 </div>

 <!-- Form and socials -->
 <div class="js-body space-y-6">
 <form class="js-form space-y-6 text-left">
 <div>
 <label class={label} for={`${id}-name`}>ІМ'Я <span class="text-rose-500">*</span></label>
 <input type="text" id={`${id}-name`} name="name" required placeholder="Ваше ім'я" autocomplete="name" class={inp} />
 </div>

 <div>
 <label class={label} for={`${id}-contact`}>ЗРУЧНИЙ ЗВ'ЯЗОК <span class="text-rose-500">*</span></label>
 <input type="text" id={`${id}-contact`} name="contact" required placeholder="Telegram, email або телефон" class={inp} />
 </div>

 <div>
 <label class={label} for={`${id}-message`}>ПОВІДОМЛЕННЯ <span class="text-rose-500">*</span></label>
 <textarea id={`${id}-message`} name="message" rows="3" required placeholder="Коротко опишіть вашу ідею..." class={`${inp} resize-none`}></textarea>
 </div>

 <button type="submit" class="w-full py-4 px-6 rounded-xl border-2 border-[#1E1414] bg-[#1E1414] text-white text-xs sm:text-sm font-black flex items-center justify-center gap-2 cursor-pointer transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] active:translate-y-0 active:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none disabled:opacity-50">
 <span>Надіслати заявку</span>
 <Icon name="arrow-right" size={13} />
 </button>
 </form>

 <div class="pt-2 space-y-3">
 <div class="text-center">
 <span class="text-[11px] font-black text-[#623A2D]/60 uppercase tracking-widest">СОЦМЕРЕЖІ</span>
 </div>
 <div class="space-y-2">
 {socials.map((s) => (
 <a href={s.href} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 px-4 rounded-xl bg-[#FAF1EC] border-2 border-[#1E1414]/40 hover:border-[#1E1414] hover:bg-white hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] transition-[translate,box-shadow,border-color,background-color] duration-200 motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none text-[#1E1414] no-underline group">
 <div class="flex items-center gap-3">
 <div class="w-7 h-7 rounded-full bg-white border-2 border-[#1E1414] flex items-center justify-center text-sm group-hover:border-[#D09AFC] transition-colors">
 <Icon name={s.icon} size={15} class={s.color} />
 </div>
 <span class="text-xs sm:text-sm font-bold text-[#1E1414]">{s.name}</span>
 </div>
 <Icon name="external-link" size={12} class="text-[#623A2D]/40 group-hover:text-[#95553C] group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-all" />
 </a>
 ))}
 </div>
 </div>
 </div>
</Drawer>

<script>
 function initContactForms() {
 document.querySelectorAll<HTMLElement>('[data-drawer]').forEach((drawer) => {
 const form = drawer.querySelector<HTMLFormElement>('.js-form');
 if (!form || form.dataset.bound === 'true') return;
 form.dataset.bound = 'true';

 const body = drawer.querySelector<HTMLElement>('.js-body');
 const success = drawer.querySelector<HTMLElement>('.js-success');
 const error = drawer.querySelector<HTMLElement>('.js-error');
 const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
 const telegramLink = drawer.querySelector<HTMLAnchorElement>('.js-telegram-link');

 const show = (screen: 'body' | 'success' | 'error') => {
 if (body) body.classList.toggle('hidden', screen !== 'body');
 if (success) success.classList.toggle('hidden', screen !== 'success');
 if (error) error.classList.toggle('hidden', screen !== 'error');
 };

 form.addEventListener('submit', async (event) => {
 event.preventDefault();
 if (submitBtn) submitBtn.disabled = true;

 const data = new FormData(form);
 const res = await fetch('/api/contact', { method: 'POST', body: data }).catch(() => null);

 if (submitBtn) submitBtn.disabled = false;

 if (!res?.ok) {
 // window.open після await блокується popup-блокатором, тому
 // готуємо посилання, яке відкриє вже користувач.
 const text = encodeURIComponent(
 `Привіт! Мене звати ${data.get('name')}. Контакт: ${data.get('contact')}. Повідомлення: ${data.get('message')}`
 );
 if (telegramLink) telegramLink.href = `https://t.me/ihornone?text=${text}`;
 show('error');
 return;
 }

 form.reset();
 show('success');
 });

 drawer.querySelector<HTMLElement>('.js-confirm')?.addEventListener('click', () => {
 show('body');
 form.reset();
 });

 drawer.querySelector<HTMLElement>('.js-retry')?.addEventListener('click', () => show('body'));
 });
 }

 initContactForms();
 document.addEventListener('astro:page-load', initContactForms);
</script>
