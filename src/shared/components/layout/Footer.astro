---
import Icon from "../ui/Icon.astro";

const currentYear = new Date().getFullYear();

const services = [
 { title: "Telegram-боти & WebApps", href: "/services/telegram-bots/" },
 { title: "Розробка сайтів та платформ", href: "/services/websites/" },
 { title: "Мобільні додатки (iOS & Android)", href: "/services/mobile-apps/" },
];

const links = [
 { title: "Головна", href: "/" },
 { title: "Портфоліо робіт", href: "/portfolio/" },
 { title: "Про мене", href: "/about/" },
 { title: "Відгуки клієнтів", href: "/reviews/" },
 { title: "Блог", href: "/blog/" },
 { title: "Політика конфіденційності", href: "/privacy/" },
];

const socials = [
 {
 icon: "telegram",
 href: "https://t.me/ihornone",
 label: "Telegram",
 },
 {
 icon: "github",
 href: "https://github.com/ihornone",
 label: "GitHub",
 },
 {
 icon: "instagram",
 href: "https://instagram.com/ihornone",
 label: "Instagram",
 },
 {
 icon: "threads",
 href: "https://threads.net/@ihornone",
 label: "Threads",
 },
];
---

<footer
 class="bg-[#2A1E1E] text-white mt-auto rounded-t-[48px] sm:rounded-t-[64px] border-t border-white/10"
 data-animate="fade-up"
>
 <div class="max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-20">
 <div
 class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-8"
 >
 <div class="lg:col-span-2 space-y-6">
 <a
 href="/"
 class="inline-flex items-center gap-3 text-2xl font-black text-white tracking-tight no-underline group"
 aria-label="ihornone - на головну"
 >
 <img
 src="/images/logo.webp"
 alt="ihornone logo"
 width="40"
 height="40"
 class="w-10 h-10 rounded-2xl object-contain group-hover:rotate-6 transition-transform shadow-md"
 loading="lazy"
 />
 <span class="tracking-tight font-black text-white">ihornone</span>
 </a>
 <p class="text-sm text-white/70 leading-relaxed max-w-sm font-medium">
 Full-Stack розробник. Створюю Telegram-боти, швидкі веб-сайти та мобільні застосунки під ключ. Прямий контакт з автором коду, запуск MVP за 14–28 днів та 30 днів гарантії на код.
 </p>
 <div class="flex items-center gap-3 pt-1">
 {
 socials.map((s) => (
 <a
 href={s.href}
 target="_blank"
 rel="noopener noreferrer"
 aria-label={s.label}
 class="w-10 h-10 rounded-xl border-2 border-white/25 flex items-center justify-center text-white/70 hover:bg-[#D09AFC] hover:text-[#1E1414] hover:border-[#D09AFC] hover:-translate-y-1 transition-all duration-200 motion-reduce:hover:translate-y-0"
 >
 <Icon name={s.icon} size={18} />
 </a>
 ))
 }
 </div>
 </div>

 <!-- Services Column -->
 <div class="space-y-4">
 <h4 class="text-xs font-black text-[#D09AFC] uppercase tracking-wider">
 Послуги
 </h4>
 <ul class="space-y-3 list-none p-0 ">
 {
 services.map((service) => (
 <li>
 <a
 href={service.href}
 class="text-sm text-white/70 hover:text-white hover:translate-x-1 inline-block transition-all duration-200 no-underline font-medium"
 >
 {service.title}
 </a>
 </li>
 ))
 }
 </ul>
 </div>

 <!-- Navigation Column -->
 <div class="space-y-4">
 <h4 class="text-xs font-black text-[#E8BA98] uppercase tracking-wider">
 Навігація
 </h4>
 <ul class="space-y-3 list-none p-0 ">
 {
 links.map((link) => (
 <li>
 <a
 href={link.href}
 class="text-sm text-white/70 hover:text-white hover:translate-x-1 inline-block transition-all duration-200 no-underline font-medium"
 >
 {link.title}
 </a>
 </li>
 ))
 }
 </ul>
 </div>

 <!-- Contact Column -->
 <div class="space-y-4">
 <h4 class="text-xs font-black text-[#FAC3C8] uppercase tracking-wider">
 Зв'язок
 </h4>
 <ul class="space-y-3 list-none p-0 ">
 <li>
 <a
 href="https://t.me/ihornone"
 target="_blank"
 rel="noopener noreferrer"
 class="text-sm text-white/80 hover:text-[#D09AFC] transition-colors no-underline flex items-center gap-3 font-medium"
 >
 <Icon name="telegram" size={18} class="text-[#D09AFC]" />
 <span>@ihornone</span>
 </a>
 </li>
 <li>
 <a
 href="mailto:hello@ihornone.site"
 class="text-sm text-white/80 hover:text-[#E8BA98] transition-colors no-underline flex items-center gap-3 font-medium"
 >
 <Icon name="envelope" size={16} class="text-[#E8BA98]" />
 <span>hello@ihornone.site</span>
 </a>
 </li>
 </ul>
 </div>
 </div>

 <!-- Bottom Bar: copyright row -->
 <div class="mt-12 pt-8 border-t border-white/15 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60 font-medium">
 <p class="m-0">
 &copy; {currentYear} ihornone. Усі права захищені.
 </p>
 <div class="flex items-center gap-2">
 <span>Створено з</span>
 <Icon name="heart" size={15} class="text-[#FAC3C8] fill-[#FAC3C8]" />
 <span>та кодом в Україні 🇺🇦</span>
 </div>
 </div>
 </div>
</footer>
