---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import ServiceCard from '../shared/components/sections/ServiceCard.astro';
import { getCollection } from 'astro:content';

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Послуги розробки — Telegram-боти, сайти та мобільні додатки | ihornone"
  description="Послуги індивідуальної розробки під ключ: Telegram-боти з оплатами, швидкі веб-сайти та мобільні застосунки на React Native. MVP за 14–28 днів, 30 днів гарантії."
  url="/services"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Послуги розробки ihornone",
    "description": "Повний перелік послуг з розробки Telegram-ботів, сайтів та додатків",
    "url": "https://www.ihornone.site/services/",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": allServices.map((s, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": s.data.title,
        "url": `https://www.ihornone.site/services/${s.id}/`,
        "description": s.data.description
      }))
    }
  }}
>
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <Hero
      title="Послуги індивідуальної розробки для бізнесу"
      buttons={[
        { label: 'Обговорити проєкт', href: 'https://t.me/ihornone', variant: 'dark' },
        { label: 'Переглянути роботи', href: '/portfolio', variant: 'outline' },
      ]}
    />

    <section class="w-full" data-animate="fade-up">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8"
        data-animate="fade-up"
        data-stagger
      >
        {
          allServices.map((service) => {
            const firstPlan = service.data.pricing?.[0];
            const startingPrice = firstPlan ? `${firstPlan.price}` : '';
            return (
              <ServiceCard
                id={service.id}
                icon={service.data.icon}
                title={service.data.title}
                shortTitle={service.data.shortTitle}
                description={service.data.description}
                isPopular={service.data.isPopular}
                startingPrice={startingPrice}
              />
            );
          })
        }
      </div>
    </section>

    <!-- Bento CTA with Mascot -->
    <BentoCta
      title="Потрібна консультація щодо вибору технологій?"
      subtitle="Напишіть мені напряму в Telegram. Безкоштовно розберемо ваше завдання, підберемо стек та розрахуємо кошторис без зобов'язань."
    />
  </div>
</Layout>
