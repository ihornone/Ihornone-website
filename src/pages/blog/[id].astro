---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../shared/components/ui/Breadcrumbs.astro';
import Card from '../../shared/components/ui/Card.astro';
import Button from '../../shared/components/ui/Button.astro';
import BentoCta from '../../shared/components/sections/BentoCta.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return allPosts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, pubDate, category, readTime, author, tags = [] } = entry.data;

const { Content } = await render(entry);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('uk-UA', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const fullUrl = `https://www.ihornone.site/blog/${entry.id}/`;
---

<Layout
  title={`${title} — Блог ihornone`}
  description={description}
  url={`/blog/${entry.id}`}
  type="article"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": author || "ihornone",
      "url": "https://www.ihornone.site/"
    },
    "publisher": {
      "@type": "Person",
      "name": "ihornone",
      "url": "https://www.ihornone.site/"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": fullUrl
    }
  }}
>
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-10 sm:space-y-14">
    <!-- Breadcrumbs -->
    <Breadcrumbs
      items={[
        { label: 'Головна', href: '/' },
        { label: 'Блог', href: '/blog' },
        { label: title },
      ]}
    />

    <!-- Article Header -->
    <header class="space-y-4 sm:space-y-5" data-animate="fade-up">
      <div class="flex items-center gap-2.5 text-xs sm:text-sm font-semibold text-[#623A2D]/60 flex-wrap">
        <span class="text-[#95553C] font-black uppercase tracking-wider">{category}</span>
        <span>•</span>
        <span>{formatDate(pubDate)}</span>
        <span>•</span>
        <span>{readTime}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.2]">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-[#623A2D]/75 leading-relaxed font-normal w-full">
        {description}
      </p>
    </header>

    <!-- Article Content Body -->
    <Card
      as="article"
      class="p-6 sm:p-10 md:p-14 bg-white/90 backdrop-blur-sm border border-[#623A2D]/10 shadow-[0_16px_40px_rgba(42,30,30,0.06)] w-full"
      data-animate="fade-up"
    >
      <div class="md-prose font-medium text-[#2A1E1E] text-base sm:text-lg leading-relaxed">
        <Content />
      </div>

      {tags && tags.length > 0 && (
        <div class="pt-8 sm:pt-10 mt-8 sm:mt-10 border-t border-[#623A2D]/10 flex flex-wrap gap-2 items-center">
          <span class="text-xs font-bold text-[#623A2D]/50 mr-1">Теги:</span>
          {tags.map((tag) => (
            <span class="text-xs font-bold text-[#623A2D]/70 bg-[#FAF1EC] px-3 py-1 rounded-full border border-[#623A2D]/10">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </Card>

    <!-- Navigation & Discuss -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2" data-animate="fade-up">
      <Button
        href="/blog"
        variant="outline"
        class="w-full sm:w-auto font-black text-xs px-6 py-3"
      >
        <i class="fa-solid fa-arrow-left mr-2"></i>
        Всі статті блогу
      </Button>
      <Button
        href="https://t.me/ihornone"
        target="_blank"
        variant="dark"
        class="w-full sm:w-auto font-black text-xs px-6 py-3"
      >
        Обговорити статтю в Telegram
      </Button>
    </div>

    <!-- Lead generation CTA -->
    <BentoCta />
  </div>
</Layout>
