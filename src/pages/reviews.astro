---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import { ReviewsMasonry } from '../features/reviews';

const imageModules = import.meta.glob('/src/content/reviews/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true, query: '?url', import: 'default' });
const imageMetaModules = import.meta.glob('/src/content/reviews/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true, import: 'default' });

// Carry the intrinsic dimensions along so the browser can reserve the exact
// space before a lazy image loads — otherwise every image that arrives shifts
// the content below it and the page visibly jumps while scrolling.
const images = Object.values(imageMetaModules).map((meta) => {
  const m = meta as unknown as { src: string; width: number; height: number };
  return { src: m.src, width: m.width, height: m.height };
});
---

<Layout
  title="Відгуки клієнтів — Результати співпраці з розробником | ihornone"
  description="Справжні скріншоти відгуків клієнтів про співпрацю з розробником ihornone: Telegram-боти з оплатами, веб-сайти та додатки, виконані в обумовлені строки."
  url="/reviews"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": "Відгуки про роботу з ihornone",
    "description": "Скріншоти та реальні відгуки клієнтів про створені Telegram-боти, сайти та застосунки",
    "url": "https://www.ihornone.site/reviews/"
  }}
>
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <Hero
      title="Реальні відгуки клієнтів про співпрацю"
    />

    <ReviewsMasonry images={images} />

    <!-- Bento CTA with Mascot -->
    <BentoCta />
  </div>
</Layout>

