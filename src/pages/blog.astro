---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import Card from '../shared/components/ui/Card.astro';
import Icon from '../shared/components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('uk-UA', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};
---

<Layout
  title="Блог — ihornone | Статті про SEO, GEO, AI та розробку"
  description="Практичні статті, інсайти та гайди про розробку Telegram-ботів, веб-сервісів, оптимізацію під Google та відповіді штучного інтелекту від ihornone."
  url="/blog"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Блог ihornone",
    "description": "Практичні статті про веб-розробку, Telegram-боти, SEO та GEO",
    "url": "https://www.ihornone.site/blog/",
    "author": {
      "@type": "Person",
      "name": "ihornone"
    }
  }}
>
  <Hero
    title="Практичні статті, кейси та думки про технології"
    tag="статті"
    tagColor="sand"
  />

  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <div class="space-y-8" data-animate="fade-up">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch" data-animate="fade-up" data-stagger>
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group no-underline block h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D09AFC] rounded-3xl"
          >
            <Card
              as="article"
              hover={true}
              class="h-full flex flex-col justify-between overflow-hidden relative"
            >
              <div class="space-y-4 flex-1 flex flex-col">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class="inline-block -rotate-2 rounded-lg bg-[#1E1414] text-white px-3 py-1 text-[11px] font-black uppercase tracking-wider">
                    ✦ {post.data.category}
                  </span>
                  <span class="text-xs font-bold text-[#623A2D]/60 flex items-center gap-1.5">
                    <Icon name="clock" size={13} />
                    {post.data.readTime}
                  </span>
                </div>

                <h2 class="text-xl sm:text-2xl font-black text-[#1E1414] tracking-tight group-hover:text-[#95553C] transition-colors leading-snug">
                  {post.data.title}
                </h2>

                <p class="text-sm text-[#623A2D]/80 leading-relaxed font-medium line-clamp-3">
                  {post.data.description}
                </p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-2 mt-auto">
                    {post.data.tags.map((tag) => (
                      <span class="text-[11px] font-bold text-[#623A2D]/70 bg-[#F4E8E3] px-3 py-1 rounded-full border border-[#1E1414]/20">
                        #{tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="pt-6 mt-6 border-t-2 border-dashed border-[#1E1414]/15 flex items-center justify-between shrink-0">
                <span class="text-xs font-bold text-[#623A2D]/60">
                  {formatDate(post.data.pubDate)}
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs font-black text-[#1E1414] group-hover:text-[#95553C] group-hover:translate-x-1 transition-all motion-reduce:transition-none">
                  <span>Читати</span>
                  <Icon name="arrow-right" size={13} />
                </span>
              </div>
            </Card>
          </a>
        ))}
      </div>
    </div>

    <BentoCta />
  </div>
</Layout>
