---
import Layout from '../layouts/Layout.astro';
import FullscreenHero from '../shared/components/sections/FullscreenHero.astro';
import BentoServices from '../shared/components/sections/BentoServices.astro';
import TurboComparison from '../shared/components/sections/TurboComparison.astro';
import SpecializationGrid from '../shared/components/sections/SpecializationGrid.astro';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');
const sortedEntries = [...allEntries].sort((a, b) => {
  const pinA = Boolean(a.data.pinned);
  const pinB = Boolean(b.data.pinned);
  if (pinA && !pinB) return -1;
  if (!pinA && pinB) return 1;

  const orderA = a.data.order ?? (typeof a.data.pinned === 'number' ? a.data.pinned : 99);
  const orderB = b.data.order ?? (typeof b.data.pinned === 'number' ? b.data.pinned : 99);
  return orderA - orderB;
});

const featuredProjects = sortedEntries.slice(0, 3).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  image: entry.data.image,
}));
---

<Layout
  title="ihornone — Сайти, Telegram-боти та Додатки, які приносять клієнтів"
  description="Створюю швидкі сайти, Telegram-боти з оплатами та мобільні додатки, які приносять клієнтів. Старт від 3 700 ₴, запуск MVP за 14–28 днів, 30 днів підтримки."
  url="/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": ["ProfessionalService", "LocalBusiness"],
    "name": "ihornone — Digital Engineering & Bot Studio",
    "alternateName": "ihornone",
    "description": "Індивідуальна розробка Telegram-ботів, конверсійних веб-сайтів та мобільних додатків на React Native для українського та міжнародного бізнесу.",
    "url": "https://ihornone.site",
    "image": "https://ihornone.site/favicon.svg",
    "priceRange": "$$",
    "currenciesAccepted": "UAH, USD, EUR",
    "paymentAccepted": "Bank Transfer, Card, Crypto",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "UA",
      "addressRegion": "Lviv / Ukraine"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "49.8397",
      "longitude": "24.0297"
    },
    "areaServed": [
      { "@type": "Country", "name": "Ukraine" },
      { "@type": "Country", "name": "Poland" },
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "European Union" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Послуги розробки під ключ",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка Telegram-ботів та WebApps",
            "description": "Боти для прийому оплат, автоматизації замовлень, CRM-інтеграції та штучного інтелекту"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка веб-сайтів та платформ",
            "description": "Швидкісні сайти на Astro, Next.js, інтеграція платіжних систем, адмін-панелей та баз даних"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка кросплатформних мобільних додатків",
            "description": "Мобільні застосунки iOS та Android на React Native / Expo з повною серверною частиною"
          }
        }
      ]
    },
    "knowsAbout": [
      "Telegram Bots Architecture",
      "Telegram WebApp (TMA)",
      "Web Development",
      "Mobile Applications",
      "React Native & Expo",
      "Astro Web Framework",
      "Node.js Backend",
      "TypeScript",
      "Stripe / Monobank / LiqPay Integrations",
      "AI & LLM Integration (OpenAI, Claude)"
    ],
    "sameAs": [
      "https://t.me/ihornone",
      "https://github.com/ihornone",
      "https://instagram.com/ihornone",
      "https://threads.net/@ihornone"
    ]
  }}
>
  <!-- Full-screen Cinematic Hero Section (UNTOUCHED) -->
  <FullscreenHero />

  <!-- Ultra-wide / Open Full Page Container (Broad fluid width) -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20 py-16 sm:py-24 space-y-20 sm:space-y-32">
    
    <!-- 1. Direction Services -->
    <BentoServices />

    <!-- 2. Guarantees & Values -->
    <TurboComparison />

    <!-- 3. Tech Specializations & Ready Modules -->
    <section class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
      <div class="w-full">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Спеціалізація та готові модулі
        </h2>
      </div>

      <SpecializationGrid />
    </section>

    <!-- 4. Featured Projects Showcase (Sticky Stacking Big Cards with Exact 16:10 Ratio, No Image Cropping) -->
    <section class="w-full space-y-8 sm:space-y-12" data-animate="fade-up">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Останні реалізовані проєкти
        </h2>

        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2A1E1E] text-white hover:bg-[#3D2C2C] text-xs font-black shadow-sm hover:shadow-md transition-all self-start sm:self-auto shrink-0 group no-underline"
        >
          <span>Усі проєкти</span>
          <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1"></i>
        </a>
      </div>

      <!-- Mobile & Tablet: 3 in a row (horizontal scroll on mobile with snap, 3-column grid on tablet) with title UNDER the photo -->
      <div class="lg:hidden">
        <div class="flex sm:grid sm:grid-cols-3 gap-4 sm:gap-6 overflow-x-auto sm:overflow-visible snap-x snap-mandatory sm:snap-none pb-4 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none touch-pan-x">
          {featuredProjects.map((project) => {
            const cleanCategory = project.category.includes('бот')
              ? 'Telegram-бот'
              : project.category.includes('Сайти')
                ? 'Сайт'
                : 'Мобільний додаток';

            return (
              <a
                href={`/portfolio/${project.id}`}
                class="group block shrink-0 snap-start w-[82vw] max-w-[340px] sm:w-auto sm:max-w-none no-underline"
              >
                <!-- Photo Container (Exact 3:2 Uncropped matching 1920x1280) -->
                <div class="w-full aspect-[3/2] rounded-[22px] sm:rounded-[26px] overflow-hidden border border-[#623A2D]/12 bg-[#2A1E1E] shadow-[0_10px_25px_rgba(42,30,30,0.06)]">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <!-- Content Block UNDER the Photo -->
                <div class="mt-3.5 flex flex-col items-start gap-1.5 px-0.5">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-[#FAF1EC] border border-[#623A2D]/10 text-[#623A2D] text-[10px] sm:text-[11px] font-black uppercase tracking-wider">
                    {cleanCategory}
                  </span>
                  <h3 class="text-base sm:text-lg font-black text-[#2A1E1E] tracking-tight leading-snug m-0 group-hover:text-[#95553C] transition-colors">
                    {project.title}
                  </h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Desktop (lg+): Large Scroll-Reveal Cards Stack (Exact 3:2 / 1920x1280 Frame, Viewport-Bounded, Zero Cropping) -->
      <div class="hidden lg:block space-y-8 sm:space-y-12 relative pb-8">
        {featuredProjects.map((project, idx) => {
          const cleanCategory = project.category.includes('бот')
            ? 'Telegram-бот'
            : project.category.includes('Сайти')
              ? 'Сайт'
              : 'Мобільний додаток';

          return (
            <a
              href={`/portfolio/${project.id}`}
              class="group block sticky top-14 lg:top-16 w-full max-w-[calc((100vh-5.5rem)*1.5)] max-h-[calc(100vh-5.5rem)] aspect-[3/2] mx-auto rounded-[24px] sm:rounded-[32px] overflow-hidden border border-[#623A2D]/12 shadow-[0_20px_50px_rgba(42,30,30,0.12)] transition-transform duration-500 hover:scale-[1.008] no-underline bg-[#2A1E1E]"
              style={`z-index: ${idx + 10};`}
            >
              <!-- Full Uncropped Cover Image (Exact 3:2 ratio 1920x1280, 100% visible) -->
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />

              <!-- Bottom Gradient Overlay (Subtle, focused only on the text area to not hide screenshot content) -->
              <div class="absolute bottom-0 left-0 right-0 h-36 sm:h-44 bg-gradient-to-t from-black/85 via-black/40 to-transparent pointer-events-none" />

              <!-- Bottom Content: Category & Title only (Compact & elegant) -->
              <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-7 lg:p-9 flex flex-col items-start gap-2 sm:gap-2.5 z-20">
                <!-- Category Pill -->
                <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] sm:text-xs font-black uppercase tracking-wider border border-white/25 shadow-xs">
                  {cleanCategory}
                </span>

                <!-- Project Title -->
                <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black text-white tracking-tight leading-snug m-0 group-hover:text-[#E8BA98] transition-colors drop-shadow-sm">
                  {project.title}
                </h3>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- 5. FAQ Accordion -->
    <section class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
      <div class="w-full">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Часті запитання клієнтів
        </h2>
      </div>

      <div class="w-full">
        <ServiceFaq globalOnly showHeader={false} />
      </div>
    </section>

    <!-- 6. Clean CTA Banner -->
    <BentoCta />

  </div>
</Layout>
