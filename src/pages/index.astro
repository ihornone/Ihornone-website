---
import Layout from '../layouts/Layout.astro';
import FullscreenHero from '../shared/components/sections/FullscreenHero.astro';
import Marquee from '../shared/components/sections/Marquee.astro';
import BentoServices from '../shared/components/sections/BentoServices.astro';
import TurboComparison from '../shared/components/sections/TurboComparison.astro';
import { Workflow } from '../features/about';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import Tag from '../shared/components/ui/Tag.astro';
import Icon from '../shared/components/ui/Icon.astro';
import MokiWidget from '../shared/components/moki/MokiWidget.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');
const sortedEntries = [...allEntries].sort((a, b) => {
  const pinA = Boolean(a.data.pinned);
  const pinB = Boolean(b.data.pinned);
  if (pinA && !pinB) return -1;
  if (!pinA && pinB) return 1;

  const orderA = a.data.order ?? (typeof a.data.pinned === 'number' ? a.data.pinned : 99);
  const orderB = b.data.order ?? (typeof b.data.pinned === 'number' ? b.data.pinned : 99);
  return orderA - orderB;
});

const featuredProjects = sortedEntries.slice(0, 3).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  image: entry.data.image,
  description: entry.data.description,
}));
---

<Layout
  title="ihornone — Розробка сайтів, Telegram-ботів та додатків | Full-Stack розробник"
  description="Full-stack розробка під ключ: Telegram-боти з оплатами, швидкі сайти та мобільні застосунки. Прямий контакт без посередників, MVP за 14–28 днів, гарантія 30 днів."
  url="/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": ["ProfessionalService", "LocalBusiness"],
    "name": "ihornone — Full-Stack Developer",
    "alternateName": "ihornone",
    "description": "Індивідуальна розробка Telegram-ботів, конверсійних веб-сайтів та мобільних додатків від Full-Stack інженера для бізнесу.",
    "url": "https://www.ihornone.site/",
    "image": "https://www.ihornone.site/favicon.svg",
    "priceRange": "$$",
    "currenciesAccepted": "UAH, USD, EUR",
    "paymentAccepted": "Bank Transfer, Card, Crypto",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "UA",
      "addressRegion": "Lviv / Ukraine"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "49.8397",
      "longitude": "24.0297"
    },
    "areaServed": [
      { "@type": "Country", "name": "Ukraine" },
      { "@type": "Country", "name": "Poland" },
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "European Union" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Послуги розробки під ключ",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка Telegram-ботів та WebApps",
            "description": "Боти для прийому оплат, автоматизації замовлень, CRM-інтеграції та штучного інтелекту"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка веб-сайтів та платформ",
            "description": "Швидкісні сайти на Astro, Next.js, інтеграція платіжних систем, адмін-панелей та баз даних"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка кросплатформних мобільних додатків",
            "description": "Мобільні застосунки iOS та Android на React Native / Expo з повною серверною частиною"
          }
        }
      ]
    },
    "knowsAbout": [
      "Telegram Bots Architecture",
      "Telegram WebApp (TMA)",
      "Web Development",
      "Mobile Applications",
      "React Native & Expo",
      "Astro Web Framework",
      "Node.js Backend",
      "TypeScript",
      "Stripe / Monobank / LiqPay Integrations",
      "AI & LLM Integration (OpenAI, Claude)"
    ],
    "sameAs": [
      "https://t.me/ihornone",
      "https://github.com/ihornone",
      "https://instagram.com/ihornone",
      "https://threads.net/@ihornone"
    ]
  }}
>
  <!-- 1. Hero panel with blueprint grid -->
  <FullscreenHero />

  <!-- 2. Running marquee band (Стрічка технологій) -->
  <Marquee />

  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-24">
    <BentoServices />
  </div>

  <!-- 4. Чому я (Guarantees & Values) -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-24">
    <TurboComparison />
  </div>

  <!-- 5. Кейси (Featured Projects Showcase — full-width espresso panel) -->
  <div
    class="w-full bg-[#1E1414] text-white rounded-[48px] sm:rounded-[64px] py-16 sm:py-24 my-8 sm:my-12"
    data-animate="fade-up"
  >
    <div class="max-w-[1800px] mx-auto w-full px-4 sm:px-8 lg:px-12 xl:px-20 space-y-8 sm:space-y-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="flex items-center gap-3 sm:gap-4">
          <h2
            data-reveal-text
            class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#FAF1EC] tracking-[-0.035em] leading-[1.13] text-left"
          >
            Останні реалізовані <Tag color="pink" class="mx-1">проєкти</Tag>
          </h2>
          <div class="shrink-0 -mt-2 hidden sm:block">
            <MokiWidget
              size={75}
              expression="fier"
              color="#FAC3C8"
              shape="galet"
              follow="page"
            />
          </div>
        </div>

        <a
          href="/portfolio/"
          class="pill-btn-lilac self-start sm:self-auto shrink-0 group"
        >
          <span>Усі проєкти</span>
          <Icon name="arrow-right" size={14} class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" />
        </a>
      </div>

      <!-- Featured Projects: Alternating Split Cards -->
      <div class="space-y-8 sm:space-y-10">
        {featuredProjects.map((project, idx) => {
          const cleanCategory = project.category.includes('бот')
            ? 'Telegram-бот'
            : project.category.includes('Сайти')
              ? 'Сайт'
              : 'Мобільний додаток';

          const isPhotoRight = idx % 2 === 0;
          const photoShadows = ['shadow-[8px_8px_0_#E8BA98]', 'shadow-[8px_8px_0_#D09AFC]', 'shadow-[8px_8px_0_#FAC3C8]'];

          return (
            <article
              data-animate="fade-up"
              class="bg-white rounded-[32px] p-6 sm:p-6 lg:p-8 border-2 border-[#1E1414] transition-[translate,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:p-8 items-stretch">
                <!-- Text Block -->
                <div
                  class:list={[
                    'order-2 flex flex-col justify-between h-full py-1',
                    isPhotoRight ? 'lg:col-span-5 lg:order-1' : 'lg:col-span-5 lg:order-2',
                  ]}
                >
                  <div class="space-y-4 sm:space-y-4">
                    <span class="inline-block -rotate-2 rounded-lg bg-[#1E1414] text-white px-4 py-2 text-xs sm:text-sm font-black uppercase tracking-wider">
                      ✦ {cleanCategory}
                    </span>

                    <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#1E1414] tracking-tight leading-snug ">
                      <a
                        href={`/portfolio/${project.id}/`}
                        class="text-[#1E1414] hover:text-[#95553C] transition-colors no-underline"
                      >
                        {project.title}
                      </a>
                    </h3>

                    {project.description && (
                      <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium leading-relaxed ">
                        {project.description}
                      </p>
                    )}
                  </div>

                  <div class="pt-6 sm:pt-8 mt-auto w-full">
                    <a
                      href={`/portfolio/${project.id}/`}
                      class="pill-btn-primary w-full !px-8 !py-4 !text-base group/btn"
                    >
                      <span>Детальніше про проєкт</span>
                      <Icon name="arrow-right" size={14} class="transition-transform duration-300 group-hover/btn:translate-x-1.5 motion-reduce:transition-none motion-reduce:group-hover/btn:translate-x-0" />
                    </a>
                  </div>
                </div>

                <!-- Photo Block -->
                <div
                  class:list={[
                    'order-1 flex items-center',
                    isPhotoRight ? 'lg:col-span-7 lg:order-2' : 'lg:col-span-7 lg:order-1',
                  ]}
                >
                  <a
                    href={`/portfolio/${project.id}/`}
                    class:list={[
                      'group/media block aspect-[3/2] w-full rounded-[24px] overflow-hidden border-2 border-[#1E1414] bg-[#2A1E1E] relative no-underline',
                      photoShadows[idx % photoShadows.length],
                    ]}
                  >
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/media:scale-105 motion-reduce:transition-none motion-reduce:group-hover/media:scale-100"
                      loading="lazy"
                    />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <!-- 6. Процес (Workflow Steps) -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-24">
    <Workflow />
  </div>

  <!-- 7. FAQ -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-24">
    <div class="space-y-8" data-animate="fade-up">
      <div class="flex items-center justify-between sm:justify-start gap-4">
        <h2
          data-reveal-text
          class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13] text-left"
        >
          Часті <Tag color="lilac" class="mx-1">запитання</Tag> клієнтів
        </h2>
        <div class="shrink-0 -mt-2 moki-float">
          <MokiWidget
            size={85}
            expression="curieux"
            color="#D09AFC"
            shape="galet"
            follow="page"
          />
        </div>
      </div>

      <div class="w-full">
        <ServiceFaq globalOnly showHeader={false} />
      </div>
    </div>
  </div>

  <!-- 8. Фінальний CTA -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 py-16 sm:py-24">
    <BentoCta />
  </div>
</Layout>
