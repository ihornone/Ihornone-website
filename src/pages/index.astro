---
import Layout from '../layouts/Layout.astro';
import FullscreenHero from '../shared/components/sections/FullscreenHero.astro';
import BentoServices from '../shared/components/sections/BentoServices.astro';
import TurboComparison from '../shared/components/sections/TurboComparison.astro';
import SpecializationGrid from '../shared/components/sections/SpecializationGrid.astro';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');
const sortedEntries = [...allEntries].sort((a, b) => {
  const pinA = Boolean(a.data.pinned);
  const pinB = Boolean(b.data.pinned);
  if (pinA && !pinB) return -1;
  if (!pinA && pinB) return 1;

  const orderA = a.data.order ?? (typeof a.data.pinned === 'number' ? a.data.pinned : 99);
  const orderB = b.data.order ?? (typeof b.data.pinned === 'number' ? b.data.pinned : 99);
  return orderA - orderB;
});

const featuredProjects = sortedEntries.slice(0, 3).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  image: entry.data.image,
  description: entry.data.description,
}));
---

<Layout
  title="ihornone — Сайти, Telegram-боти та Додатки, які приносять клієнтів"
  description="Створюю швидкі сайти, Telegram-боти з оплатами та мобільні додатки, які приносять клієнтів. Старт від 3 700 ₴, запуск MVP за 14–28 днів, 30 днів підтримки."
  url="/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": ["ProfessionalService", "LocalBusiness"],
    "name": "ihornone — Digital Engineering & Bot Studio",
    "alternateName": "ihornone",
    "description": "Індивідуальна розробка Telegram-ботів, конверсійних веб-сайтів та мобільних додатків на React Native для українського та міжнародного бізнесу.",
    "url": "https://ihornone.site",
    "image": "https://ihornone.site/favicon.svg",
    "priceRange": "$$",
    "currenciesAccepted": "UAH, USD, EUR",
    "paymentAccepted": "Bank Transfer, Card, Crypto",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "UA",
      "addressRegion": "Lviv / Ukraine"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "49.8397",
      "longitude": "24.0297"
    },
    "areaServed": [
      { "@type": "Country", "name": "Ukraine" },
      { "@type": "Country", "name": "Poland" },
      { "@type": "Country", "name": "United States" },
      { "@type": "Country", "name": "European Union" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Послуги розробки під ключ",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка Telegram-ботів та WebApps",
            "description": "Боти для прийому оплат, автоматизації замовлень, CRM-інтеграції та штучного інтелекту"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка веб-сайтів та платформ",
            "description": "Швидкісні сайти на Astro, Next.js, інтеграція платіжних систем, адмін-панелей та баз даних"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Розробка кросплатформних мобільних додатків",
            "description": "Мобільні застосунки iOS та Android на React Native / Expo з повною серверною частиною"
          }
        }
      ]
    },
    "knowsAbout": [
      "Telegram Bots Architecture",
      "Telegram WebApp (TMA)",
      "Web Development",
      "Mobile Applications",
      "React Native & Expo",
      "Astro Web Framework",
      "Node.js Backend",
      "TypeScript",
      "Stripe / Monobank / LiqPay Integrations",
      "AI & LLM Integration (OpenAI, Claude)"
    ],
    "sameAs": [
      "https://t.me/ihornone",
      "https://github.com/ihornone",
      "https://instagram.com/ihornone",
      "https://threads.net/@ihornone"
    ]
  }}
>
  <!-- Full-screen Cinematic Hero Section (UNTOUCHED) -->
  <FullscreenHero />

  <!-- Ultra-wide / Open Full Page Container (Broad fluid width) -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-14 xl:px-20 py-16 sm:py-24 space-y-20 sm:space-y-32">
    
    <!-- 1. Direction Services -->
    <BentoServices />

    <!-- 2. Guarantees & Values -->
    <TurboComparison />

    <!-- 3. Tech Specializations & Ready Modules -->
    <section class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
      <div class="w-full">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Спеціалізація та готові модулі
        </h2>
      </div>

      <SpecializationGrid />
    </section>

    <!-- 4. Featured Projects Showcase (Sticky Stacking Big Cards with Exact 16:10 Ratio, No Image Cropping) -->
    <section class="w-full space-y-8 sm:space-y-12" data-animate="fade-up">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Останні реалізовані проєкти
        </h2>

        <a
          href="/portfolio"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#2A1E1E] text-white hover:bg-[#3D2C2C] text-xs font-black shadow-sm hover:shadow-md transition-all self-start sm:self-auto shrink-0 group no-underline"
        >
          <span>Усі проєкти</span>
          <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1"></i>
        </a>
      </div>

      <!-- Featured Projects: Alternating Split Cards (Photo Right / Text Left, Photo Left / Text Right) on Desktop; Clean Photo + Text below on Mobile -->
      <div class="space-y-6 sm:space-y-8 lg:space-y-10">
        {featuredProjects.map((project, idx) => {
          const cleanCategory = project.category.includes('бот')
            ? 'Telegram-бот'
            : project.category.includes('Сайти')
              ? 'Сайт'
              : 'Мобільний додаток';

          // idx 0: Photo right, Text left
          // idx 1: Photo left, Text right
          // idx 2: Photo right, Text left
          const isPhotoRight = idx % 2 === 0;

          return (
            <article class="bg-white rounded-[24px] sm:rounded-[32px] p-5 sm:p-7 lg:p-9 border border-[#623A2D]/10 shadow-[0_12px_36px_rgba(42,30,30,0.04)] hover:shadow-[0_20px_48px_rgba(42,30,30,0.08)] transition-all duration-300">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-stretch">
                <!-- Text Block: on mobile order-2 (under photo), on desktop order-1 if text-left, order-2 if text-right -->
                <div
                  class:list={[
                    'order-2 flex flex-col justify-between h-full py-1',
                    isPhotoRight ? 'lg:col-span-5 lg:order-1' : 'lg:col-span-5 lg:order-2',
                  ]}
                >
                  <!-- Top Content: Category on top, Title, Description -->
                  <div class="space-y-3.5 sm:space-y-4">
                    <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#FAF1EC] border border-[#623A2D]/12 text-[#623A2D] text-[11px] sm:text-xs font-black uppercase tracking-wider">
                      {cleanCategory}
                    </span>

                    <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-[#2A1E1E] tracking-tight leading-snug m-0">
                      <a
                        href={`/portfolio/${project.id}`}
                        class="text-[#2A1E1E] hover:text-[#95553C] transition-colors no-underline"
                      >
                        {project.title}
                      </a>
                    </h3>

                    {project.description && (
                      <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium leading-relaxed m-0">
                        {project.description}
                      </p>
                    )}
                  </div>

                  <!-- Bottom: Very Large Prominent Button moved to the bottom -->
                  <div class="pt-6 sm:pt-8 mt-auto w-full">
                    <a
                      href={`/portfolio/${project.id}`}
                      class="w-full inline-flex items-center justify-center gap-3 px-8 py-3.5 sm:py-4 rounded-full bg-[#2A1E1E] text-white hover:bg-[#3D2C2C] text-sm sm:text-base font-black shadow-xs hover:shadow-md transition-all duration-300 no-underline group/btn"
                    >
                      <span>Детальніше про проєкт</span>
                      <i class="fa-solid fa-arrow-right text-xs transition-transform duration-300 group-hover/btn:translate-x-1.5" aria-hidden="true" />
                    </a>
                  </div>
                </div>

                <!-- Photo Block: on mobile order-1 (photo on top), on desktop order-2 if photo-right, order-1 if photo-left -->
                <div
                  class:list={[
                    'order-1 flex items-center',
                    isPhotoRight ? 'lg:col-span-7 lg:order-2' : 'lg:col-span-7 lg:order-1',
                  ]}
                >
                  <a
                    href={`/portfolio/${project.id}`}
                    class="group/media block aspect-[3/2] w-full rounded-[18px] sm:rounded-[24px] overflow-hidden border border-[#623A2D]/12 bg-[#2A1E1E] shadow-sm relative no-underline"
                  >
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/media:scale-105"
                      loading="lazy"
                    />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- 5. FAQ Accordion -->
    <section class="w-full space-y-8 sm:space-y-10" data-animate="fade-up">
      <div class="w-full">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#2A1E1E] tracking-tight leading-[1.15] m-0 text-left">
          Часті запитання клієнтів
        </h2>
      </div>

      <div class="w-full">
        <ServiceFaq globalOnly showHeader={false} />
      </div>
    </section>

    <!-- 6. Clean CTA Banner -->
    <BentoCta />

  </div>
</Layout>
