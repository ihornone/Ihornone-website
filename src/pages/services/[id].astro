---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../shared/components/sections/Faq.astro';
import Tag from '../../shared/components/ui/Tag.astro';
import BentoCta from '../../shared/components/sections/BentoCta.astro';
import MokiWidget from '../../shared/components/moki/MokiWidget.astro';
import ProcessSteps from '../../shared/components/sections/ProcessSteps.astro';
import Breadcrumbs from '../../shared/components/ui/Breadcrumbs.astro';
import Button from '../../shared/components/ui/Button.astro';
import SectionHeader from '../../shared/components/ui/SectionHeader.astro';
import ProjectCard from '../../features/portfolio/components/ProjectCard.astro';
import {
  ServiceDetailHero,
  ServiceIncludes,
  ServicePricing,
} from '../../features/services';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return allServices.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  title,
  shortTitle,
  icon,
  description,
  heroSubtitle,
  isPopular,
  includes,
  examples,
  process,
  technologies,
  pricing,
  faq,
} = entry.data;

const startingPrice = pricing?.[0]?.price || '';

const allProjects = await getCollection('projects');
const sortedServiceProjects = allProjects
  .filter((p) => {
    if (entry.id === 'telegram-bots') return p.id.startsWith('bot-');
    if (entry.id === 'websites') return p.id.startsWith('web-');
    if (entry.id === 'mobile-apps') return p.id.startsWith('mobile-');
    return true;
  })
  .sort((a, b) => {
    const pinA = Boolean(a.data.pinned);
    const pinB = Boolean(b.data.pinned);
    if (pinA && !pinB) return -1;
    if (!pinA && pinB) return 1;

    const orderA = a.data.order ?? (typeof a.data.pinned === 'number' ? a.data.pinned : 99);
    const orderB = b.data.order ?? (typeof b.data.pinned === 'number' ? b.data.pinned : 99);
    return orderA - orderB;
  });

const latestProject = sortedServiceProjects[0] ? {
  id: sortedServiceProjects[0].id,
  title: sortedServiceProjects[0].data.title,
  category: sortedServiceProjects[0].data.category,
  type: sortedServiceProjects[0].data.type,
  duration: sortedServiceProjects[0].data.duration,
  technologies: sortedServiceProjects[0].data.technologies,
  description: sortedServiceProjects[0].data.description,
  image: sortedServiceProjects[0].data.image,
} : null;

const serviceProjects = sortedServiceProjects
  .slice(0, 3)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    category: p.data.category,
    icon: p.data.icon,
    image: p.data.image,
    description: p.data.description,
    meta: { technologies: p.data.technologies },
  }));
---

<Layout
  title={`${title} — Послуги розробки | ihornone`}
  description={description}
  url={`/services/${entry.id}`}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": title,
    "description": description,
    "provider": {
      "@type": "Person",
      "name": "ihornone",
      "url": "https://www.ihornone.site/"
    },
    "areaServed": "UA",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `Тарифи: ${title}`,
      "itemListElement": pricing?.map((p: any) => ({
        "@type": "Offer",
        "name": p.name,
        "price": p.price.replace(/[^\d]/g, '') || undefined,
        "priceCurrency": "UAH",
        "description": p.description
      })) || []
    }
  }}
>
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 pt-2 sm:pt-4 pb-16 sm:py-24 space-y-16 sm:space-y-24">
    <!-- 1. Breadcrumbs & Hero -->
    <div class="space-y-8">
      <Breadcrumbs
        items={[
          { label: 'Усі послуги', href: '/services/' },
          { label: title },
        ]}
      />

      <ServiceDetailHero
        title={title}
        shortTitle={shortTitle}
        icon={icon}
        description={description}
        heroSubtitle={heroSubtitle}
        startingPrice={startingPrice}
        technologies={technologies}
        latestProject={latestProject}
      />
    </div>

    <!-- 2. Що входить (4 ключові пункти) -->
    <ServiceIncludes includes={includes} />

    <!-- 3. Кейси саме цього напрямку (2-3 проєкти) -->
    {serviceProjects.length > 0 && (
      <section class="space-y-8 w-full" data-animate="fade-up">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <SectionHeader
            title="Приклади реалізованих рішень"
            highlight="реалізованих"
            tagColor="lilac"
          />
          <Button href="/portfolio/" variant="outline" size="sm" icon="arrow-right">
            Усі кейси
          </Button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" data-animate="fade-up" data-stagger>
          {serviceProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )}

    <!-- 4. Тарифи з одним рядком технологій -->
    <ServicePricing pricing={pricing} technologies={technologies} />

    <!-- 5. Процес (4 великі картки) -->
    <ProcessSteps title="Як відбувається процес розробки" steps={process} />

    <!-- 6. FAQ (3-4 питання про послугу у темному espresso блоці) -->
    <div
      class="w-full bg-[#2A1E1E] text-white rounded-[48px] sm:rounded-[64px] py-16 sm:py-20"
      data-animate="fade-up"
    >
      <div class="max-w-[1800px] mx-auto w-full px-4 sm:px-8 lg:px-12 xl:px-20 space-y-8">
        <div class="flex items-center justify-between sm:justify-start gap-4">
          <h2
            data-reveal-text
            class="text-3xl sm:text-4xl lg:text-[56px] font-black text-white tracking-[-0.035em] leading-[1.13]"
          >
            Часті <Tag color="lilac" class="mx-1">запитання</Tag> про послугу
          </h2>
          <div class="shrink-0 -mt-2">
            <MokiWidget
              size={85}
              expression="curieux"
              color="#D09AFC"
              shape="galet"
              follow="page"
            />
          </div>
        </div>

        <div class="w-full">
          <Faq items={faq} showHeader={false} />
        </div>
      </div>
    </div>

    <!-- 7. Єдиний фінальний CTA banner -->
    <BentoCta
      title="Маєте завдання для розробки?"
      subtitle="Зв'яжіться зі мною напряму в Telegram — обговоримо концепцію, терміни та бюджет без жодних зобов'язань."
    />
  </div>
</Layout>
