---
import Layout from '../layouts/Layout.astro';
import Icon from '../shared/components/ui/Icon.astro';
import MokiWidget from '../shared/components/moki/MokiWidget.astro';
---

<Layout
  title="Мої сервіси — Незабаром у релізі | ihornone"
  description="Розділ сервісів у розробці. Тим часом повний список послуг та ціни доступні на сторінці послуг."
  url="/my-services"
>
  <div class="w-full max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-12 pt-8 sm:pt-14 pb-16 sm:pb-24">
    <div
      class="bg-white border-2 border-[#1E1414] rounded-[32px] sm:rounded-[48px] p-8 sm:p-12 lg:p-16 shadow-[8px_8px_0_#D09AFC] text-center flex flex-col items-center gap-6"
      data-animate="fade-up"
    >
      <div class="relative flex items-center justify-center p-2">
        <MokiWidget
          size={160}
          color="#D09AFC"
          state="sleep"
          expression="attentif"
          follow={false}
        />
      </div>

      <div class="flex flex-col items-center gap-3 max-w-xl">
        <span class="inline-block -rotate-2 rounded-lg bg-[#D09AFC] text-[#1E1414] px-3.5 py-1 text-xs font-black uppercase tracking-wider">
          ✦ Незабаром у релізі
        </span>

        <h1
          data-reveal-text
          class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#1E1414] tracking-tight leading-tight m-0"
        >
          Каталог сервісів готується
        </h1>

        <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium leading-relaxed">
          Я саме структуру структурую розширений каталог послуг з фіксованими тарифами, термінами та готовими стеками. А поки що всі актуальні послуги, ціни та формат роботи доступні в основному розділі.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="/services/" class="pill-btn-primary flex items-center gap-2">
          <span>Перейти до послуг</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <a href="/" class="pill-btn-outline flex items-center gap-2">
          <span>На головну</span>
        </a>
        <a href="https://t.me/ihornone" target="_blank" rel="noopener noreferrer" class="pill-btn-lilac flex items-center gap-2">
          <Icon name="telegram" size={16} />
          <span>Написати в Telegram</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
