---
import Layout from '../layouts/Layout.astro';
import Stats from '../shared/components/sections/Stats.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import {
  AboutHero,
  WhyMe,
  FeaturedWorks,
  ComparisonTable,
  CodeGuarantee,
  TechStack,
  Workflow,
} from '../features/about';

const stats = [
  {
    value: '100%',
    label: 'прозорий процес',
    subtext: 'код у вашому GitHub',
    link: { text: 'Дивитись кейси в портфоліо', href: '/portfolio/' },
  },
  {
    value: '3+',
    label: 'роки досвіду',
    subtext: 'Full-Stack розробки',
  },
  {
    value: '14–28',
    label: 'днів на запуск MVP',
    subtext: 'від ТЗ до перших клієнтів',
  },
  {
    value: '30 днів',
    label: 'гарантійної підтримки',
    subtext: 'безкоштовні фікси після релізу',
  },
];
---

<Layout
  title="Про мене — ihornone | Full-Stack розробник Telegram-ботів та веб-сайтів"
  description="Індивідуальна розробка Telegram-ботів, веб-сервісів та мобільних додатків для бізнесу. Пряма комунікація з інженером, запуск MVP за 14–28 днів, 30 днів гарантії."
  url="/about"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "ihornone",
      "jobTitle": "Full-Stack Developer",
      "description": "Full-stack розробник з 3+ роками комерційного досвіду. Розробка Telegram-ботів з оплатою, кросплатформних мобільних додатків та веб-сайтів для бізнесу.",
      "knowsAbout": ["Telegram Bots", "Astro", "React Native", "TypeScript", "Node.js", "Python", "Full-Stack Web Development"],
      "sameAs": [
        "https://t.me/ihornone",
        "https://github.com/ihornone",
        "https://instagram.com/ihornone",
        "https://threads.net/@ihornone"
      ]
    }
  }}
>
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 pt-4 sm:pt-6 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <!-- 1. Головний блок із презентацією -->
    <AboutHero />

    <!-- 2. Ряд цифр (швидка довіра) -->
    <Stats items={stats} columns={4} />

    <!-- 3. Чому обирають співпрацю зі мною -->
    <WhyMe />

    <!-- 4. Ключові кейси -->
    <FeaturedWorks />

    <!-- 5. Таблиця «Якість агентства» (порівняння з агентствами та іншими фрилансерами) -->
    <ComparisonTable />

    <!-- 6. Блок 30-денної гарантії з конкретикою -->
    <CodeGuarantee />

    <!-- 7. Стек технологій -->
    <TechStack />

    <!-- 8. Етапи розробки -->
    <Workflow />

    <!-- 9. Заклик до дії -->
    <BentoCta />
  </div>
</Layout>
