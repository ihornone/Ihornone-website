---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import Tag from '../shared/components/ui/Tag.astro';
import MokiWidget from '../shared/components/moki/MokiWidget.astro';
import { PortfolioFilterGrid } from '../features/portfolio';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');

const allProjects = allEntries
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    category: entry.data.category,
    icon: entry.data.icon,
    image: entry.data.image,
    description: entry.data.description,
    pinned: entry.data.pinned,
    order: entry.data.order,
    statusBadge: entry.data.statusBadge,
    meta: {
      technologies: entry.data.technologies,
    },
  }))
  .sort((a, b) => {
    const pinA = Boolean(a.pinned);
    const pinB = Boolean(b.pinned);
    if (pinA && !pinB) return -1;
    if (!pinA && pinB) return 1;

    const orderA = a.order ?? (typeof a.pinned === 'number' ? a.pinned : 99);
    const orderB = b.order ?? (typeof b.pinned === 'number' ? b.pinned : 99);
    return orderA - orderB;
  });

const categories = ['Усі проєкти', ...new Set(allProjects.map((p) => p.category))];
---

<Layout
  title="Портфоліо — Реалізовані сайти, боти та додатки | ihornone"
  description="Кейси розробки веб-сайтів, мобільних додатків та Telegram-ботів з онлайн-оплатами. Приклади рішень, технологічний стек та вимірювані результати для бізнесу."
  url="/portfolio"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Портфоліо проєктів ihornone",
    "description": "Кейси розробки веб-сайтів, Telegram-ботів та мобільних додатків",
    "url": "https://www.ihornone.site/portfolio/",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": allProjects.map((p, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": p.title,
        "url": `https://www.ihornone.site/portfolio/${p.id}/`,
        "description": p.description
      }))
    }
  }}
>
          <Hero
      title="Кейси та реалізовані цифрові рішення для бізнесу"
      tag="Кейси"
      tagColor="pink"
    />

<div class="w-full max-w-[1800px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-20 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <PortfolioFilterGrid categories={categories} projects={allProjects} />

    <!-- FAQ Section -->
    <div class="space-y-8 sm:space-y-12" data-animate="fade-up">
      <div class="flex items-center justify-between sm:justify-start gap-4">
        <h2
          data-reveal-text
          class="text-3xl sm:text-4xl lg:text-[56px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13]"
        >
          Часті <Tag color="pink" class="mx-1">запитання</Tag> клієнтів
        </h2>
        <div class="shrink-0 -mt-2 moki-float" style="animation-delay:-2.4s">
          <MokiWidget
            size={85}
            expression="curieux"
            color="#D09AFC"
            shape="galet"
            follow="page"
          />
        </div>
      </div>

      <div class="w-full">
        <ServiceFaq globalOnly showHeader={false} />
      </div>
    </div>

    <!-- CTA banner -->
    <BentoCta />
  </div>
</Layout>
