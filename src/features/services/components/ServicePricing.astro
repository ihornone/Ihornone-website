---
interface PricingPlan {
  name: string;
  price: string;
  range?: string;
  timeline?: string;
  forWhom?: string;
  description: string;
  features: string[];
}

interface Props {
  pricing: PricingPlan[];
}

const { pricing } = Astro.props;
---

{pricing && pricing.length > 0 && (
  <section class="space-y-6 sm:space-y-8 w-full" data-animate="fade-up">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#2A1E1E] tracking-tight m-0 text-left">
      Тарифи та вартість
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 items-stretch">
      {pricing.map((plan) => (
        <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-7 border border-[#623A2D]/10 shadow-[0_12px_36px_rgba(42,30,30,0.05)] hover:shadow-[0_20px_48px_rgba(42,30,30,0.1)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-4">
            <div>
              <h3 class="text-xl sm:text-2xl font-black text-[#2A1E1E] m-0 tracking-tight">
                {plan.name}
              </h3>
            </div>

            <div class="pt-1">
              <div class="text-2xl sm:text-3xl font-black text-[#2A1E1E] tracking-tight">
                {plan.range || plan.price}
              </div>
              {plan.timeline && (
                <span class="text-xs text-[#623A2D]/60 font-medium block mt-1">
                  Термін: {plan.timeline}
                </span>
              )}
            </div>

            <ul class="space-y-2 pt-4 border-t border-[#623A2D]/10 list-none p-0 m-0">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-xs font-medium text-[#2A1E1E]/80 leading-relaxed">
                  <span class="text-[#623A2D]/40 text-xs select-none">•</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 mt-auto">
            <a
              href={`https://t.me/ihornone?text=${encodeURIComponent(`Привіт! Мене цікавить тариф "${plan.name}".`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-5 rounded-full bg-[#2A1E1E] text-white hover:bg-[#3D2C2C] text-xs font-black transition-all duration-200 no-underline"
            >
              <span>Обрати {plan.name}</span>
              <i class="fa-solid fa-arrow-right text-[10px]" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
