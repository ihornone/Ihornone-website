---
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';
import Icon from '../../../shared/components/ui/Icon.astro';

interface PricingPlan {
  name: string;
  price: string;
  range?: string;
  timeline?: string;
  forWhom?: string;
  description: string;
  features: string[];
}

interface Props {
  pricing: PricingPlan[];
  technologies?: string[];
}

const { pricing, technologies = [] } = Astro.props;
---

{pricing && pricing.length > 0 && (
  <section class="space-y-8 w-full" data-animate="fade-up">
    <SectionHeader
      title="Тарифи та вартість"
      highlight="вартість"
      tagColor="sand"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {pricing.map((plan) => (
        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#1E1414] transition-[translate,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none flex flex-col justify-between">
          <div class="space-y-5">
            <div>
              <span class="inline-block rounded-md bg-[#F4E8E3] border border-[#1E1414]/20 px-2.5 py-1 text-[11px] font-black uppercase tracking-wider text-[#1E1414] mb-2">
                Пакет
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-[#1E1414] tracking-tight">
                {plan.name}
              </h3>
            </div>

            <!-- Price & Timeline: matching homepage format and high-contrast -->
            <div class="space-y-2 pt-1">
              <div class="text-3xl sm:text-4xl font-black text-[#1E1414] tracking-[-0.04em]">
                {plan.price}
              </div>
              {plan.timeline && (
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-[#F4E8E3] border border-[#1E1414]/20 text-xs font-bold text-[#1E1414]">
                  <Icon name="clock" size={13} class="text-[#95553C]" />
                  <span>Термін: {plan.timeline}</span>
                </div>
              )}
            </div>

            {plan.description && (
              <p class="text-xs sm:text-sm text-[#1E1414]/85 font-medium leading-relaxed">
                {plan.description}
              </p>
            )}

            <ul class="space-y-2.5 pt-4 border-t-2 border-dashed border-[#1E1414]/20 list-none p-0">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm font-semibold text-[#1E1414] leading-relaxed">
                  <span class="text-[#D09AFC] text-sm select-none shrink-0 font-black">✦</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 mt-auto">
            <a
              href={`https://t.me/ihornone?text=${encodeURIComponent(`Привіт! Мене цікавить тариф "${plan.name}".`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-2xl border-2 border-[#1E1414] bg-[#1E1414] text-white text-xs sm:text-sm font-black transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_0_#D09AFC] active:translate-y-0 active:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none no-underline"
            >
              <span>Обрати {plan.name}</span>
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
