---
import Card from '../../../shared/components/ui/Card.astro';
import IconBox from '../../../shared/components/ui/IconBox.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface IncludeItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  includes: IncludeItem[];
}

const { includes = [] } = Astro.props;
const displayIncludes = includes.slice(0, 4);
---

<section class="space-y-8 w-full" data-animate="fade-up">
  <SectionHeader
    title="Що входить у послугу"
    highlight="входить"
    tagColor="pink"
  />
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 xl:gap-8 items-stretch" data-animate="fade-up" data-stagger>
    {displayIncludes.map((item) => (
      <Card hover class="flex flex-col items-start p-6 lg:p-5 xl:p-6 space-y-4 h-full">
        <IconBox icon={item.icon} />
        <div class="space-y-2 flex-1 flex flex-col justify-start">
          <h3 class="text-lg sm:text-[19px] font-black text-[#1E1414] tracking-tight leading-snug">
            {item.title}
          </h3>
          <p class="text-xs sm:text-[13.5px] text-[#1E1414]/85 font-medium leading-relaxed">
            {item.description}
          </p>
        </div>
      </Card>
    ))}
  </div>
</section>
