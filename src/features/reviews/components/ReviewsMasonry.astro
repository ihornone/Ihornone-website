---
import Icon from '../../../shared/components/ui/Icon.astro';

export interface ReviewItem {
  id: string;
  image?: {
    src: string;
    width: number;
    height: number;
  };
}

interface Props {
  reviews: ReviewItem[];
}

const { reviews } = Astro.props;
const photoReviews = reviews.filter((r) => Boolean(r.image));
---

<section class="w-full">
  {photoReviews.length > 0 ? (
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 sm:gap-8 [column-fill:_balance]" data-animate="fade-up">
      {photoReviews.map((review, idx) => (
        <div
          class="break-inside-avoid mb-6 sm:mb-8 rounded-[24px] sm:rounded-[32px] overflow-hidden border-2 border-[#1E1414] bg-white shadow-[6px_6px_0_#D09AFC] hover:shadow-[10px_10px_0_#1E1414] hover:-translate-y-1.5 transition-[box-shadow,translate] duration-200 motion-reduce:transition-none motion-reduce:hover:shadow-[6px_6px_0_#D09AFC] motion-reduce:hover:translate-y-0 group cursor-pointer relative"
          data-lightbox
          data-lightbox-src={review.image!.src}
          role="button"
          tabindex="0"
          aria-label={`Відкрити скріншот відгуку ${idx + 1}`}
        >
          <img
            src={review.image!.src}
            alt={`Скріншот відгуку клієнта ${idx + 1}`}
            width={review.image!.width}
            height={review.image!.height}
            class="w-full h-auto block object-contain transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-[#1E1414]/30 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center gap-2 text-white text-xs font-black backdrop-blur-xs">
            <span class="px-3.5 py-1.5 rounded-full bg-white/95 text-[#1E1414] shadow-md flex items-center gap-1.5 border border-[#1E1414]/15">
              <Icon name="maximize-2" size={13} />
              <span>Збільшити</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-center text-[#623A2D]/60 text-sm">Відгуки клієнтів скоро зʼявляться на цій сторінці</p>
  )}

  <dialog id="lightbox" class="fixed inset-0 z-[200] bg-transparent p-0 max-w-none max-h-none w-full h-full opacity-0 pointer-events-none backdrop:bg-black/85 backdrop:backdrop-blur-sm transition-opacity duration-200">
    <button id="lightbox-close" class="fixed top-5 right-5 z-[201] w-11 h-11 rounded-full bg-white/15 hover:bg-white/30 text-white flex items-center justify-center cursor-pointer border border-white/20 transition-colors duration-200" aria-label="Закрити">
      <Icon name="x" size={22} />
    </button>
    <div class="w-full h-full flex items-center justify-center p-4 sm:p-8" id="lightbox-backdrop">
      <img id="lightbox-img" src="" alt="Відгук клієнта" class="max-w-[92vw] max-h-[90vh] object-contain rounded-2xl shadow-2xl border-2 border-white/20" />
    </div>
  </dialog>
</section>

<script>
  function setupLightbox() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const backdrop = document.getElementById('lightbox-backdrop');
    if (!dialog || !img) return;

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
      const open = () => {
        const src = trigger.dataset.lightboxSrc;
        if (!src) return;
        img.src = src;
        dialog.showModal();
        dialog.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
      };

      trigger.addEventListener('click', open);
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });

    const close = () => {
      dialog.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        if (dialog.open) dialog.close();
        img.src = '';
        document.body.style.overflow = '';
      }, 150);
    };

    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) close();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
