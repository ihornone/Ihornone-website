---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'project-card group flex flex-col justify-between rounded-[24px] sm:rounded-[32px] overflow-hidden border border-[#623A2D]/10 bg-white p-4 sm:p-5 shadow-[0_12px_36px_rgba(42,30,30,0.04)] hover:border-[#D09AFC] hover:shadow-[0_22px_48px_rgba(42,30,30,0.1)] hover:-translate-y-1.5 transition-all duration-300 text-[#2A1E1E]',
    className
  ]}
  data-category={project.category}
>
  <!-- 1. Велика картка фото (3:2, без обрізань, без зайвих бейджів) -->
  <a
    href={`/portfolio/${project.id}`}
    class="block aspect-[3/2] w-full rounded-[18px] sm:rounded-[22px] overflow-hidden bg-[#2A1E1E] relative border border-[#623A2D]/8 shadow-xs no-underline group/media"
    aria-label={project.title}
  >
    <img
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
    />
  </a>

  <!-- Тіло картки під фото: Категорія, Назва, Кнопка -->
  <div class="pt-5 pb-1 px-1 flex flex-col flex-1 justify-between space-y-4">
    <div class="space-y-3">
      <!-- 2. Категорія -->
      <div>
        <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#FAF1EC] border border-[#623A2D]/12 text-[#623A2D] text-[11px] sm:text-xs font-black uppercase tracking-wider">
          {project.category}
        </span>
      </div>

      <!-- 3. Назва -->
      <h3 class="text-lg sm:text-xl font-black text-[#2A1E1E] m-0 tracking-tight leading-snug group-hover:text-[#95553C] transition-colors">
        <a href={`/portfolio/${project.id}`} class="text-[#2A1E1E] hover:text-[#95553C] transition-colors no-underline">
          {project.title}
        </a>
      </h3>
    </div>

    <!-- 4. Кнопка -->
    <div class="pt-2 mt-auto w-full">
      <a
        href={`/portfolio/${project.id}`}
        class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full bg-[#2A1E1E] text-white hover:bg-[#3D2C2C] text-xs sm:text-sm font-black shadow-xs hover:shadow-md transition-all duration-300 no-underline group/btn"
        aria-label={`Детальніше про проєкт ${project.title}`}
      >
        <span>Детальніше про проєкт</span>
        <i class="fa-solid fa-arrow-right text-[11px] transition-transform duration-300 group-hover/btn:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
