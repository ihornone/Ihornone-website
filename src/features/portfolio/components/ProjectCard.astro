---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<a
  href={`/portfolio/${project.id}`}
  class:list={[
    'project-card group flex flex-col justify-between rounded-[24px] overflow-hidden border border-[#623A2D]/10 bg-white shadow-[0_16px_36px_rgba(42,30,30,0.06)] hover:border-[#D09AFC] hover:shadow-[0_24px_52px_rgba(42,30,30,0.12)] hover:-translate-y-1.5 transition-all duration-300 no-underline text-[#2A1E1E]',
    className
  ]}
  data-category={project.category}
>
  <!-- Card Image Header with soft rounded frame -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#FAF1EC]">
    <img
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

    <div class="absolute top-4 left-4 z-10 flex flex-wrap items-center gap-2 max-w-[80%]">
      <span class="bg-[#2A1E1E]/90 backdrop-blur-md text-white text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">
        {project.category}
      </span>
      {project.statusBadge && (
        <span class="bg-white/95 backdrop-blur-md text-[#623A2D] border border-[#623A2D]/15 text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-xs">
          {project.statusBadge}
        </span>
      )}
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between space-y-4">
    <div class="space-y-2.5">
      <h3 class="text-lg sm:text-xl font-black text-[#2A1E1E] m-0 tracking-tight leading-snug group-hover:text-[#95553C] transition-colors">
        {project.title}
      </h3>
      <p class="text-xs sm:text-sm text-[#623A2D]/75 leading-relaxed font-medium m-0 line-clamp-2">
        {project.description}
      </p>
    </div>

    <!-- Technologies & Action -->
    <div class="pt-4 border-t border-[#623A2D]/10 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {project.meta?.technologies && (
          project.meta.technologies.split(',').slice(0, 2).map((tech) => (
            <span class="bg-[#FAF1EC] text-[#2A1E1E] border border-[#623A2D]/10 text-[10px] font-bold px-2.5 py-1 rounded-full">
              {tech.trim()}
            </span>
          ))
        )}
      </div>

      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FAF1EC] group-hover:bg-[#2A1E1E] group-hover:text-white text-xs font-black text-[#2A1E1E] transition-all duration-300">
        <span>Кейс</span>
        <i class="fa-solid fa-arrow-right text-[10px] transition-transform duration-300 group-hover:translate-x-0.5"></i>
      </span>
    </div>
  </div>
</a>
