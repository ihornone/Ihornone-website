---
import type { Project } from '../data/projects';
import Icon from '../../../shared/components/ui/Icon.astro';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'project-card relative cursor-pointer group flex flex-col justify-between rounded-3xl overflow-hidden border-2 border-[#1E1414] bg-white p-4 sm:p-6 transition-[translate,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] focus-within:ring-2 focus-within:ring-[#D09AFC] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none text-[#2A1E1E]',
    className
  ]}
  data-category={project.category}
>
  <div class="aspect-[3/2] w-full rounded-2xl overflow-hidden bg-[#2A1E1E] relative border-2 border-[#1E1414] shadow-[6px_6px_0_#E8BA98] group/media">
    <img
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none"
      loading="lazy"
    />
  </div>

  <div class="pt-6 pb-1 px-1 flex flex-col flex-1 justify-between space-y-4">
    <div class="space-y-3">
      <div>
        <span class="inline-block -rotate-2 rounded-lg bg-[#1E1414] text-white px-3 py-1 text-[11px] font-black uppercase tracking-wider">
          ✦ {project.category}
        </span>
      </div>

      <h3 class="text-lg sm:text-xl font-black text-[#1E1414] tracking-tight leading-snug group-hover:text-[#95553C] transition-colors">
        <a
          href={`/portfolio/${project.id}/`}
          class="text-[#1E1414] group-hover:text-[#95553C] transition-colors no-underline after:absolute after:inset-0 after:z-10 focus:outline-none"
        >
          {project.title}
        </a>
      </h3>
    </div>

    <div class="pt-2 mt-auto w-full">
      <div
        class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 rounded-xl border-2 border-[#1E1414] bg-[#1E1414] text-white text-xs sm:text-sm font-black transition-[translate,box-shadow] duration-200 group-hover:-translate-y-0.5 group-hover:shadow-[0_6px_0_#D09AFC] active:translate-y-0 active:shadow-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none group/btn pointer-events-none"
        aria-hidden="true"
      >
        <span>Детальніше про проєкт</span>
        <Icon name="arrow-right" size={13} class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" />
      </div>
    </div>
  </div>
</article>
