---
import Icon from '../../../shared/components/ui/Icon.astro';

interface ProjectNav {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  prevProject?: ProjectNav | null;
  nextProject?: ProjectNav | null;
}

const { prevProject, nextProject } = Astro.props;
---

<section class="w-full bento-card p-4 sm:p-6 flex items-center justify-between gap-3" data-animate="fade-up">
  {prevProject ? (
    <a href={`/portfolio/${prevProject.id}/`} class="flex items-center gap-3 text-[#1E1414] hover:text-[#95553C] transition-colors no-underline">
      <Icon name="arrow-left" size={16} />
      <div class="text-left">
        <span class="text-[10px] sm:text-[11px] font-bold text-[#623A2D]/60 uppercase block">Попередній</span>
        <strong class="text-xs sm:text-sm font-black block">{prevProject.data.title}</strong>
      </div>
    </a>
  ) : <div />}

  {nextProject ? (
    <a href={`/portfolio/${nextProject.id}/`} class="flex items-center gap-3 text-[#1E1414] hover:text-[#95553C] transition-colors no-underline ml-auto">
      <div class="text-right">
        <span class="text-[10px] sm:text-[11px] font-bold text-[#623A2D]/60 uppercase block">Наступний</span>
        <strong class="text-xs sm:text-sm font-black block">{nextProject.data.title}</strong>
      </div>
      <Icon name="arrow-right" size={16} />
    </a>
  ) : <div />}
</section>
