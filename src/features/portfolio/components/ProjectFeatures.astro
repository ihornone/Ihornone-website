---
import IconBox from '../../../shared/components/ui/IconBox.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface FeatureItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features: FeatureItem[];
}

const { features } = Astro.props;
---

<section class="space-y-8 w-full" data-animate="fade-up">
  <SectionHeader
    title="Функціональні можливості"
    highlight="можливості"
    tagColor="lilac"
  />
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8" data-animate="fade-up" data-stagger>
    {features.map((f) => (
      <div class="bg-white border-2 border-[#1E1414] rounded-3xl p-6 space-y-4 flex flex-col justify-start hover:-translate-y-1 hover:shadow-[0_12px_0_#D09AFC] transition-[translate,box-shadow] duration-200">
        <IconBox icon={f.icon} />
        <div class="space-y-2 flex-1">
          <h3 class="text-base sm:text-lg font-black text-[#1E1414] leading-snug">{f.title}</h3>
          <p class="text-xs sm:text-sm text-[#1E1414]/85 font-medium leading-relaxed">{f.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
