---
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface ResultItem {
 value: string;
 description: string;
}

interface Props {
 results: ResultItem[];
}

const { results } = Astro.props;
---

{results && results.length > 0 && (
 <section class="space-y-8 w-full" data-animate="fade-up">
 <SectionHeader title="Результати проєкту" />
 <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-animate="fade-up" data-stagger>
 {results.map((res) => (
 <div class="bento-card p-6 text-center space-y-2 flex flex-col justify-center">
 <div class="text-2xl sm:text-3xl md:text-4xl font-black text-[#1E1414] tracking-[-0.04em]">{res.value}</div>
 <p class="text-xs sm:text-sm text-[#623A2D]/75 font-medium leading-snug">{res.description}</p>
 </div>
 ))}
 </div>
 </section>
)}
