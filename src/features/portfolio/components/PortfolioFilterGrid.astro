---
import ProjectCard from './ProjectCard.astro';

interface Props {
  categories: string[];
  projects: any[];
}

const { categories, projects } = Astro.props;
---

<section class="space-y-8 w-full" data-animate="fade-up">
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    {categories.map((category, i) => (
      <button
        data-category={category}
        class={`filter-tab px-6 py-3 rounded-xl font-bold text-xs sm:text-sm transition-[background-color,border-color,color,box-shadow,translate] duration-200 cursor-pointer border-2 motion-reduce:transition-none ${i === 0 ? 'bg-[#1E1414] text-white border-[#1E1414]' : 'bg-white text-[#1E1414] border-[#1E1414]/40 hover:border-[#1E1414] hover:-translate-y-0.5 hover:shadow-[0_4px_0_#D09AFC] motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none'}`}
      >
        {category}
      </button>
    ))}
  </div>

  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:p-6" data-animate="fade-up" data-stagger>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('#projects-grid .project-card'));
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Motion constants: exits stay fast, the measured FLIP glide matches the
    // site's --ease-out-expo character, stagger sits inside the 30–80ms band.
    const EXIT_MS = 240;
    const FLIP_MS = 450;
    const STAGGER_MS = 45;

    const ACTIVE = ['bg-[#1E1414]', 'text-white', 'border-[#1E1414]'];
    const IDLE = [
      'bg-white',
      'text-[#1E1414]',
      'border-[#1E1414]/40',
      'hover:border-[#1E1414]',
      'hover:-translate-y-0.5',
      'hover:shadow-[0_4px_0_#D09AFC]',
    ];

    // Every pending async step of the current choreography lives in one
    // cancelable set: a new filter click retargets from the live state
    // instead of racing a stale cleanup timer.
    let hideTimer: number | undefined;
    let flipTimers: number[] = [];

    const cancelPending = () => {
      window.clearTimeout(hideTimer);
      flipTimers.forEach((t) => window.clearTimeout(t));
      hideTimer = undefined;
      flipTimers = [];
    };

    function applyFilter(selected: string) {
      cancelPending();

      // First — remember where every currently-visible card sits
      const first = new Map<HTMLElement, DOMRect>();
      projectCards.forEach((card) => {
        if (card.style.display !== 'none') first.set(card, card.getBoundingClientRect());
      });

      // Split cards into exits (fade out now), stays (will glide) and
      // entering (kept display:none until the reflow so they never flash).
      const stays: HTMLElement[] = [];
      const exits: HTMLElement[] = [];
      const entering: HTMLElement[] = [];
      projectCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const shouldShow = selected === 'Усі проєкти' || category === selected;
        const wasVisible = card.style.display !== 'none';

        if (shouldShow) {
          if (wasVisible) stays.push(card);
          else entering.push(card);
        } else if (wasVisible) {
          exits.push(card);
        }
      });

      if (REDUCED) {
        exits.concat(entering).forEach((card) => {
          card.style.display = 'none';
          card.classList.remove('is-hidden');
        });
        stays.forEach((card) => card.classList.remove('is-hidden'));
        return;
      }

      // Exit: visible cards fade out fast, then leave the layout so the grid
      // reflows. A card re-shown mid-fade retargets through the CSS opacity
      // transition — no snap.
      exits.forEach((card) => card.classList.add('is-hidden'));
      hideTimer = window.setTimeout(() => {
        exits.forEach((card) => {
          card.style.display = 'none';
          card.classList.remove('is-hidden');
        });

        // Invert + Play — cards glide from their old slot into the new one.
        stays.forEach((card, index) => {
          const previous = first.get(card);
          card.classList.remove('is-hidden');
          card.style.scale = '';
          if (!previous) return;

          const next = card.getBoundingClientRect();
          const dx = previous.left - next.left;
          const dy = previous.top - next.top;
          if (dx === 0 && dy === 0) return;

          // Inline FLIP: suppress transitions, jump to the old slot, then
          // glide back to identity. Inline transform (not CSS variables) so
          // the 3D-tilt engine — which also writes inline transforms — can
          // never collide with a half-applied variable state.
          const delay = index * STAGGER_MS;
          card.style.transition = `transform ${FLIP_MS}ms var(--ease-out-expo) ${delay}ms`;
          card.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
          void card.offsetWidth; // force reflow so the jump itself isn't transitioned
          card.style.transform = '';
          flipTimers.push(
            window.setTimeout(() => {
              card.style.transition = '';
            }, FLIP_MS + delay + 100),
          );
        });

        // Newly revealed cards: fade + scale in with the same stagger.
        entering.forEach((card, index) => {
          const delay = index * STAGGER_MS;
          card.style.display = '';
          card.classList.add('is-hidden');
          card.style.scale = '0.96';
          card.style.transitionDelay = `${delay}ms`;
          // Двофазний rAF + таймерний fallback (webview без rAF): без нього
          // картка назавжди лишилася б у is-hidden (opacity 0).
          const reveal = () => {
            card.classList.remove('is-hidden');
            card.style.scale = '';
          };
          requestAnimationFrame(() => {
            requestAnimationFrame(reveal);
          });
          window.setTimeout(reveal, 60 + delay);
          flipTimers.push(
            window.setTimeout(() => {
              card.style.transitionDelay = '';
            }, FLIP_MS + delay + 100),
          );
        });
      }, EXIT_MS);
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selected = tab.getAttribute('data-category') ?? '';

        filterTabs.forEach((t) => {
          t.classList.remove(...ACTIVE);
          t.classList.add(...IDLE);
        });
        tab.classList.remove(...IDLE);
        tab.classList.add(...ACTIVE);

        applyFilter(selected);
      });
    });
  });
</script>
