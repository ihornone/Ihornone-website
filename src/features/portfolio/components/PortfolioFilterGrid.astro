---
import ProjectCard from './ProjectCard.astro';

interface Props {
  categories: string[];
  projects: any[];
}

const { categories, projects } = Astro.props;
---

<section class="space-y-8 w-full" data-animate="fade-up">
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    {categories.map((category, i) => (
      <button
        data-category={category}
        class={`filter-tab px-5 py-2.5 rounded-full font-bold text-xs sm:text-sm transition-all cursor-pointer border ${i === 0 ? 'bg-[#2A1E1E] text-white border-[#2A1E1E] shadow-sm' : 'bg-white text-[#2A1E1E] border-[#623A2D]/10 hover:border-[#D09AFC]'}`}
      >
        {category}
      </button>
    ))}
  </div>

  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7" data-animate="fade-up" data-stagger>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('#projects-grid .project-card'));

    const ACTIVE = ['bg-[#2A1E1E]', 'text-white', 'border-[#2A1E1E]', 'shadow-sm'];
    const IDLE = ['bg-white', 'text-[#2A1E1E]', 'border-[#623A2D]/10'];

    function applyFilter(selected: string) {
      // First — remember where every visible card currently sits
      const first = new Map<HTMLElement, DOMRect>();
      projectCards.forEach((card) => {
        if (card.style.display !== 'none') first.set(card, card.getBoundingClientRect());
      });

      // Last — switch visibility and let the grid reflow
      const shown: HTMLElement[] = [];
      projectCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const shouldShow = selected === 'Усі проєкти' || category === selected;

        if (shouldShow) {
          card.style.display = '';
          card.classList.remove('is-hidden');
          shown.push(card);
        } else {
          card.style.display = 'none';
          card.classList.remove('is-hidden');
        }
      });

      // Invert + Play — cards glide from their old slot into the new one
      shown.forEach((card, index) => {
        const previous = first.get(card);
        const next = card.getBoundingClientRect();

        if (!previous) {
          // Newly revealed card: fade and scale in
          card.classList.add('is-hidden');
          requestAnimationFrame(() => {
            card.style.transitionDelay = `${index * 45}ms`;
            card.classList.remove('is-hidden');
          });
          return;
        }

        const dx = previous.left - next.left;
        const dy = previous.top - next.top;
        if (dx === 0 && dy === 0) return;

        card.style.setProperty('--flip-x', `${dx.toFixed(1)}px`);
        card.style.setProperty('--flip-y', `${dy.toFixed(1)}px`);

        requestAnimationFrame(() => {
          card.style.transitionDelay = `${index * 45}ms`;
          card.style.setProperty('--flip-x', '0px');
          card.style.setProperty('--flip-y', '0px');
        });
      });

      // Clean up the inline delay once the choreography finished
      window.setTimeout(() => {
        projectCards.forEach((card) => {
          card.style.transitionDelay = '';
          card.style.removeProperty('--flip-x');
          card.style.removeProperty('--flip-y');
        });
      }, 800);
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selected = tab.getAttribute('data-category') ?? '';

        filterTabs.forEach((t) => {
          t.classList.remove(...ACTIVE);
          t.classList.add(...IDLE);
        });
        tab.classList.remove(...IDLE);
        tab.classList.add(...ACTIVE);

        applyFilter(selected);
      });
    });
  });
</script>
