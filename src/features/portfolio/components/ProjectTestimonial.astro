---
import Card from '../../../shared/components/ui/Card.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';
import Icon from '../../../shared/components/ui/Icon.astro';

interface Testimonial {
 quote: string;
 author: string;
 role: string;
 rating?: number;
}

interface Props {
 testimonial?: Testimonial;
}

const { testimonial } = Astro.props;
---

{testimonial && (
 <Card padding="lg" class="space-y-6 sm:space-y-6 w-full" data-animate="fade-up">
 <SectionHeader title="Відгук клієнта" />
 <blockquote class="space-y-4 ">
 <p class="text-base sm:text-lg md:text-xl text-[#1E1414]/90 font-medium italic leading-relaxed ">
 «{testimonial.quote}»
 </p>
 <div class="flex items-center justify-between flex-wrap gap-4 pt-3 border-t-2 border-dashed border-[#1E1414]/20">
 <div>
 <strong class="block text-sm sm:text-base font-black text-[#1E1414]">{testimonial.author}</strong>
 <span class="text-xs sm:text-sm text-[#623A2D]/70 font-medium">{testimonial.role}</span>
 </div>
 {testimonial.rating && (
 <div class="flex items-center gap-1 text-[#E8BA98] text-sm">
 {Array.from({ length: testimonial.rating }).map(() => (
 <Icon name="star" size={16} class="fill-[#E8BA98] text-[#E8BA98]" />
 ))}
 </div>
 )}
 </div>
 </blockquote>
 </Card>
)}
