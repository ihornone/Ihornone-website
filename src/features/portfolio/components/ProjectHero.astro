---
import Button from '../../../shared/components/ui/Button.astro';
import Passport from '../../../shared/components/sections/Passport.astro';
import QuickContactModal from '../../../shared/components/ui/QuickContactModal.astro';

interface Props {
  title: string;
  category: string;
  icon?: string;
  description: string;
  image?: string;
  link?: string;
  github?: string;
  statusBadge?: string;
  passportFields: Array<{ label: string; value: any }>;
}

const {
  title,
  category,
  icon,
  description,
  image,
  link,
  github,
  statusBadge,
  passportFields,
} = Astro.props;
---

<section
  class="relative w-full bg-white border-2 border-[#1E1414] rounded-[32px] sm:rounded-[48px] p-6 sm:p-8 lg:p-12 space-y-8 text-left shadow-sm overflow-hidden"
  data-animate="fade-up"
>
  <!-- Top Split: Details Left, Screenshot Mockup Right -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-7 flex flex-col items-start gap-5">
      <span class="inline-block -rotate-2 rounded-lg bg-[#1E1414] text-white px-3.5 py-1.5 text-xs font-black uppercase tracking-wider">
        ✦ {category}
      </span>

      <h1
        data-reveal-text
        class="text-3xl sm:text-4xl lg:text-[52px] font-black text-[#1E1414] tracking-[-0.035em] leading-[1.13]"
      >
        {title}
      </h1>

      {description && (
        <p class="text-sm sm:text-base lg:text-lg text-[#1E1414]/85 font-medium leading-relaxed max-w-xl">
          {description}
        </p>
      )}

      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-2 w-full sm:w-auto">
        {category === 'Мобільні застосунки' && link && (
          <Button href={link} target="_blank" variant="dark" icon="android" class="w-full sm:w-auto">
            Завантажити демо APK
          </Button>
        )}

        {category === 'Сайти' && link && (
          <Button href={link} target="_blank" variant="dark" icon="external-link" class="w-full sm:w-auto">
            {statusBadge?.includes('Комерційний') ? 'Відкрити сайт компанії' : 'Відкрити Live Demo'}
          </Button>
        )}

        {category === 'Telegram-боти' && link && (
          <Button href={link} target="_blank" variant="dark" icon="telegram" class="w-full sm:w-auto">
            Запустити бота
          </Button>
        )}

        {github && (
          <Button href={github} target="_blank" variant="outline" icon="github" class="w-full sm:w-auto">
            Код на GitHub
          </Button>
        )}

        <QuickContactModal
          triggerText="Замовити схожий проєкт"
          triggerClass="pill-btn-lilac !py-3.5 !px-6 !text-sm w-full sm:w-auto flex items-center justify-center gap-2 cursor-pointer"
        />
      </div>
    </div>

    <!-- Right: Screenshot / Mockup -->
    {image && (
      <div class="lg:col-span-5 w-full flex items-center justify-center">
        <div class="w-full aspect-[3/2] rounded-2xl overflow-hidden border-2 border-[#1E1414] shadow-[0_8px_24px_rgba(30,20,20,0.1)] bg-[#2A1E1E]">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
            loading="eager"
          />
        </div>
      </div>
    )}
  </div>

  <!-- Bottom: Passport fields -->
  <Passport fields={passportFields} />
</section>
