---
import Card from '../../../shared/components/ui/Card.astro';
import IconBox from '../../../shared/components/ui/IconBox.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface WhyMeItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  items?: WhyMeItem[];
  class?: string;
}

const defaultItems: WhyMeItem[] = [
  {
    icon: 'fa-solid fa-tags',
    title: 'Пряма вартість інженерії',
    desc: 'Оплата виключно за створення продукту. Відсутність витрат на менеджерський штат та офіси заощаджує до 40% вашого бюджету за агентської якості коду.'
  },
  {
    icon: 'fa-solid fa-rocket',
    title: 'Запуск MVP за 14–28 днів',
    desc: 'Перший робочий прототип ви тестуєте вже в перший тиждень. Швидкі ітерації без бюрократії дозволяють перевірити ідею та запуститися в рекордні терміни.'
  },
  {
    icon: 'fa-solid fa-user-check',
    title: 'Прямий контакт з автором коду',
    desc: 'Спілкуєтеся безпосередньо зі мною, а не через ланцюжок посередників. Технічні питання та правки обговорюються й впроваджуються за лічені хвилини.'
  },
  {
    icon: 'fa-solid fa-bolt',
    title: 'Глибока профільна експертиза',
    desc: 'Фокус на Telegram-ботах з онлайн-оплатою, надшвидких веб-сайтах на Astro/React та мобільних додатках на React Native з перевіреною архітектурою.'
  },
  {
    icon: 'fa-solid fa-layer-group',
    title: 'Повний цикл під ключ',
    desc: 'Беру на себе всі етапи: проектування архітектури, дизайн інтерфейсу, бекенд, інтеграцію платіжних систем, тестування та фінальний запуск.'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: '30 днів гарантії на код',
    desc: 'Після релізу надаю місяць безкоштовної технічної підтримки: усунення прихованих помилок, допомогу з сервером та оперативні відповіді в Telegram.'
  },
];

const { items = defaultItems, class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <div class="text-center max-w-xl mx-auto">
    <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
      Чому обирають мене
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" data-animate="fade-up" data-stagger>
    {items.map((item) => (
      <Card hover class="space-y-4 h-full flex flex-col justify-start">
        <IconBox icon={item.icon} size="md" />
        <div class="space-y-1.5 flex-1">
          <h3 class="text-base font-black text-[#2A1E1E] m-0">{item.title}</h3>
          <p class="text-xs sm:text-sm text-[#623A2D]/75 font-medium leading-relaxed m-0">{item.desc}</p>
        </div>
      </Card>
    ))}
  </div>
</section>
