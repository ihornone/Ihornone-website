---
import Card from '../../../shared/components/ui/Card.astro';
import IconBox from '../../../shared/components/ui/IconBox.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface WhyMeItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  items?: WhyMeItem[];
  class?: string;
}

const defaultItems: WhyMeItem[] = [
  {
    icon: 'user-check',
    title: 'Прямий контакт із розробником',
    desc: 'Спілкуєтеся безпосередньо з автором коду без акаунт-менеджерів та зіпсованого телефону. Будь-які технічні питання та правки узгоджуються за лічені хвилини.'
  },
  {
    icon: 'rocket',
    title: 'Швидкий запуск MVP за 14–28 днів',
    desc: 'Перший інтерактивний прототип ви тестуєте вже на 5–7 день. Швидкі спринти без зайвої бюрократії дозволяють перевірити ідею на ринку в обумовлені строки.'
  },
  {
    icon: 'coins',
    title: 'Економія до 40% кошторису',
    desc: 'Оплата виключно за чисту інженерію. Відсутність витрат на оренду офісів та менеджерський штат студій дає високу якість за чесну та фіксовану ціну.'
  },
  {
    icon: 'shield-check',
    title: '30 днів гарантії та 100% ваш Git',
    desc: 'Весь код належить вам з першого коміту у вашому репозиторії. Після релізу надаю місяць безкоштовної гарантійної підтримки та нагляду за сервером.'
  },
];

const { items = defaultItems, class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <SectionHeader
    title="Чому обирають співпрацю зі мною"
    highlight="співпрацю"
    tagColor="caramel"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 xl:gap-8 items-stretch" data-animate="fade-up" data-stagger>
    {items.map((item) => (
      <Card hover class="p-6 lg:p-5 xl:p-6 space-y-4 h-full flex flex-col justify-start">
        <IconBox icon={item.icon} size="md" />
        <div class="space-y-2 flex-1 flex flex-col justify-start">
          <h3 class="text-lg sm:text-[19px] font-black text-[#1E1414] tracking-tight leading-snug">{item.title}</h3>
          <p class="text-xs sm:text-[13.5px] text-[#1E1414]/85 font-medium leading-relaxed flex-1">{item.desc}</p>
        </div>
      </Card>
    ))}
  </div>
</section>
