---
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';
import Icon from '../../../shared/components/ui/Icon.astro';

interface CellData {
  text: string;
  status: 'good' | 'neutral';
}

interface ComparisonRow {
  feature: string;
  me: CellData;
  agency: CellData;
  freelancer: CellData;
}

interface Props {
  class?: string;
}

const comparisonRows: ComparisonRow[] = [
  {
    feature: 'Рівень інженерії та дизайн',
    me: { text: 'Агентський рівень', status: 'good' },
    agency: { text: 'Агентський рівень', status: 'good' },
    freelancer: { text: 'Залежить від навичок', status: 'neutral' },
  },
  {
    feature: 'Вартість проєкту',
    me: { text: 'Пряма ціна (економія до 40%)', status: 'good' },
    agency: { text: 'Висока (офіс + менеджери)', status: 'neutral' },
    freelancer: { text: 'Низька або плаваюча', status: 'neutral' },
  },
  {
    feature: 'Швидкість запуску MVP',
    me: { text: '14–28 днів', status: 'good' },
    agency: { text: '1.5–3 місяці', status: 'neutral' },
    freelancer: { text: 'Непередбачувано', status: 'neutral' },
  },
  {
    feature: 'Комунікація',
    me: { text: 'Прямо з автором коду', status: 'good' },
    agency: { text: 'Через менеджера (PM)', status: 'neutral' },
    freelancer: { text: 'Прямий контакт', status: 'good' },
  },
  {
    feature: 'Робота під ключ (дизайн + код)',
    me: { text: 'Повний цикл від ідеї до релізу', status: 'good' },
    agency: { text: 'Повний цикл від ідеї до релізу', status: 'good' },
    freelancer: { text: 'Часто лише окрема частина', status: 'neutral' },
  },
  {
    feature: 'Гарантійна підтримка',
    me: { text: '30 днів включено', status: 'good' },
    agency: { text: 'За окремим контрактом', status: 'neutral' },
    freelancer: { text: 'За домовленістю', status: 'neutral' },
  },
  {
    feature: 'Контроль та вихідний код',
    me: { text: 'Ваш приватний Git з 1-го дня', status: 'good' },
    agency: { text: 'Корпоративний репозиторій', status: 'good' },
    freelancer: { text: 'За домовленістю', status: 'neutral' },
  },
];

const { class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <SectionHeader
    title="Якість агентства — вигода прямого розробника"
    highlight="агентства"
    tagColor="lilac"
  />

  <div
    class="bg-white border-2 border-[#1E1414] rounded-3xl overflow-hidden transition-[translate,box-shadow] duration-200 hover:shadow-[0_12px_0_#D09AFC]"
    data-animate="fade-up"
  >
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[640px]">
        <thead>
          <tr class="border-b-2 border-[#1E1414] bg-[#FAF1EC]">
            <th class="p-4 sm:p-5 font-black text-[#1E1414] w-[28%] text-sm sm:text-base">Критерій</th>
            <th class="p-4 sm:p-5 font-black text-[#1E1414] text-left bg-[#D09AFC]/20 border-x-2 border-[#1E1414] w-[26%]">
              <span class="inline-flex items-center gap-2 text-xs sm:text-sm font-black uppercase tracking-wider text-[#1E1414]">
                <span class="size-6 rounded-full bg-[#1E1414] text-white flex items-center justify-center shrink-0">
                  <Icon name="cat" size={13} class="text-white" />
                </span>
                <span>ihornone (розробник)</span>
              </span>
            </th>
            <th class="p-4 sm:p-5 font-bold text-[#623A2D]/80 text-left w-[23%] text-xs sm:text-sm">Digital-агентства</th>
            <th class="p-4 sm:p-5 font-bold text-[#623A2D]/80 text-left w-[23%] text-xs sm:text-sm">Інші фрилансери</th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-[#1E1414]/10">
          {comparisonRows.map((row) => (
            <tr class="hover:bg-[#FAF1EC]/40 transition-colors">
              <td class="p-4 sm:p-5 font-black text-[#1E1414] align-middle">
                {row.feature}
              </td>

              <!-- ihornone -->
              <td class="p-4 sm:p-5 bg-[#D09AFC]/15 border-x-2 border-[#1E1414] align-middle">
                <div class="inline-flex items-center gap-2.5 text-xs sm:text-sm font-black text-[#1E1414]">
                  <span class="size-5 rounded-full bg-[#D09AFC] border-2 border-[#1E1414] text-[#1E1414] flex items-center justify-center shrink-0 shadow-2xs">
                    <Icon name="check" size={12} strokeWidth={3} />
                  </span>
                  <span>{row.me.text}</span>
                </div>
              </td>

              <!-- agency -->
              <td class="p-4 sm:p-5 align-middle">
                <div class="inline-flex items-center gap-2.5 text-xs sm:text-sm font-bold text-[#1E1414]">
                  {row.agency.status === 'good' ? (
                    <span class="size-5 rounded-full bg-[#D09AFC]/40 border-2 border-[#1E1414] text-[#1E1414] flex items-center justify-center shrink-0">
                      <Icon name="check" size={12} strokeWidth={3} />
                    </span>
                  ) : (
                    <span class="size-5 rounded-full bg-[#FAF1EC] border-2 border-[#1E1414]/30 text-[#623A2D]/70 flex items-center justify-center shrink-0">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </span>
                  )}
                  <span>{row.agency.text}</span>
                </div>
              </td>

              <!-- freelancer -->
              <td class="p-4 sm:p-5 align-middle">
                <div class="inline-flex items-center gap-2.5 text-xs sm:text-sm font-bold text-[#623A2D]/80">
                  {row.freelancer.status === 'good' ? (
                    <span class="size-5 rounded-full bg-[#D09AFC]/40 border-2 border-[#1E1414] text-[#1E1414] flex items-center justify-center shrink-0">
                      <Icon name="check" size={12} strokeWidth={3} />
                    </span>
                  ) : (
                    <span class="size-5 rounded-full bg-[#FAF1EC] border-2 border-[#1E1414]/30 text-[#623A2D]/70 flex items-center justify-center shrink-0">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </span>
                  )}
                  <span>{row.freelancer.text}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
