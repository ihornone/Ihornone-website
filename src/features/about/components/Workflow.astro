---
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';
import Card from '../../../shared/components/ui/Card.astro';

interface WorkflowStep {
 step: string;
 title: string;
 desc: string;
}

interface Props {
 steps?: WorkflowStep[];
 class?: string;
}

const defaultSteps: WorkflowStep[] = [
 {
 step: '01',
 title: 'Аналіз завдання та кошторис',
 desc: 'Обговорюємо вимоги у Telegram, підбираємо стек технологій та фіксуємо точний бюджет і дедлайн до старту робіт.'
 },
 {
 step: '02',
 title: 'Архітектура та перший прототип',
 desc: 'Проєктую базу даних, логіку взаємодії та інтерфейс. Перший інтерактивний прототип ви тестуєте вже на 5–7 день.'
 },
 {
 step: '03',
 title: 'Розробка та інтеграція',
 desc: 'Пишу чистий код, підключаю онлайн-оплати (Monobank, LiqPay, Stripe), бази даних, CRM та AI-моделі.'
 },
 {
 step: '04',
 title: 'Тестування, реліз і гарантія',
 desc: 'Тестую всі сценарії під навантаженням, налаштовую сервер і домен. Запускаємо проєкт і надаю 30 днів гарантійної підтримки.'
 },
];

const { steps = defaultSteps, class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <SectionHeader
    title="Як побудований процес співпраці"
    highlight="процес"
    tagColor="lilac"
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 xl:gap-8 items-stretch" data-animate="fade-up" data-stagger>
  {steps.map((item) => (
    <Card hover class="space-y-4 relative overflow-hidden h-full flex flex-col justify-start p-6 lg:p-5 xl:p-6">
      <span class="text-3xl sm:text-4xl font-black text-[#95553C] tracking-tight block">
        {item.step}
      </span>
      <h3 class="text-lg sm:text-[19px] font-black text-[#1E1414] tracking-tight leading-snug">{item.title}</h3>
      <p class="text-xs sm:text-[13.5px] text-[#623A2D]/80 font-medium leading-relaxed flex-1">{item.desc}</p>
    </Card>
  ))}
  </div>
</section>
