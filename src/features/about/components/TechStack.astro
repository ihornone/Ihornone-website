---
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';
import Card from '../../../shared/components/ui/Card.astro';
import Icon from '../../../shared/components/ui/Icon.astro';

interface StackCategory {
 category: string;
 icon: string;
 items: string[];
}

interface Props {
 class?: string;
}

const defaultCategories: StackCategory[] = [
 {
 category: 'Web & Сайти',
 icon: 'globe',
 items: [
 'React & Next.js',
 'Astro & Vite',
 'TypeScript / JavaScript',
 'Tailwind CSS & SCSS',
 'HTML5 / CSS3 / Responsive UI',
 'SSR, SPA & Оптимізація SEO',
 ],
 },
 {
 category: 'Мобільні застосунки',
 icon: 'smartphone',
 items: [
 'React Native',
 'Expo Framework',
 'Кросплатформність (iOS & Android)',
 'Нативні модулі та пуш-сповіщення',
 'Офлайн-кеш та синхронізація',
 'Публікація в App Store & Google Play',
 ],
 },
 {
 category: 'Telegram & Боти',
 icon: 'telegram',
 items: [
 'aiogram 3 & Python',
 'Telegram Mini Apps (TMA)',
 'Telegram Bot API & Webhooks',
 'Багаторівневі інтерактивні сценарії',
 'CRM-боти та автоворонки',
 'High-load черги та асинхронність',
 ],
 },
 {
 category: 'Backend & Бази даних',
 icon: 'server',
 items: [
 'Node.js (Express / Fastify)',
 'Python (FastAPI / Django)',
 'PostgreSQL, MySQL, SQLite',
 'Redis (кешування та черги)',
 'REST API, GraphQL & WebSocket',
 'Docker & Linux VPS (Ubuntu / Debian)',
 ],
 },
 {
 category: 'Платежі & Fintech',
 icon: 'credit-card',
 items: [
 'Monobank API (еквайринг та QR)',
 'LiqPay & PrivatBank',
 'WayForPay & NovaPay',
 'Stripe & PayPal',
 'Автофіскалізація (Checkbox / Вчасно)',
 'Рекурентні платежі та підписки',
 ],
 },
 {
 category: 'Інтеграції & Інструменти',
 icon: 'settings',
 items: [
 'Інтеграція з CRM (KeyCRM, SalesDrive)',
 'Google Sheets & Drive API',
 'OpenAI & Claude AI інтеграції',
 'Нова Пошта & Укрпошта API',
 'Git, GitHub & CI/CD автоматизація',
 'Sentry & Моніторинг працездатності',
 ],
 },
];

const { class: className = '' } = Astro.props;
---

<section id="tech-stack" class:list={['space-y-8 w-full', className]} data-animate="fade-up">
 <!-- Section Title -->
 <SectionHeader
 title="Технології, з якими я працюю"
 highlight="працюю"
 tagColor="sand"
 />

 <!-- Expanded Lists with Checkmarks Grid -->
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" data-animate="fade-up" data-stagger>
 {defaultCategories.map((cat) => (
 <Card hover class="space-y-4 h-full flex flex-col justify-start">
 <div class="flex items-center gap-3 pb-3 border-b-2 border-dashed border-[#1E1414]/20">
 <div class="w-8 h-8 rounded-full bg-[#E8BA98] flex items-center justify-center text-[#1E1414] text-sm shrink-0 border-2 border-[#1E1414]">
 <Icon name={cat.icon} size={16} />
 </div>
 <h3 class="text-sm sm:text-base font-black text-[#1E1414] ">
 {cat.category}
 </h3>
 </div>

 <ul class="space-y-3 list-none p-0 ">
 {cat.items.map((tech) => (
 <li class="flex items-start gap-3 text-xs sm:text-sm font-bold text-[#1E1414]/90 leading-tight">
 <Icon name="circle-check" size={14} class="text-[#95553C] shrink-0 mt-0.5" />
 <span>{tech}</span>
 </li>
 ))}
 </ul>
 </Card>
 ))}
 </div>
</section>
